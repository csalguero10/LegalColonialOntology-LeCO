    <body>
      <div type="acta" xml:id="cab-001-003_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-003_s001" type="juridical_discursive_segment">
          <date xml:id="cab-001-003_cab-001-003_s001_a001" type="sourceDate">3 de Septiembre de 1547</date>.</seg>
        <seg xml:id="cab-001-003_s002" type="juridical_discursive_segment">En este <orgName xml:id="cab-001-003_cab-001-003_s002_a001" type="cabildo" ref="#org_cab-001-003_cab-001-003_s002_a001">Cabildo</orgName> se reunierón los señores <persName xml:id="cab-001-003_cab-001-003_s002_a002" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s002_a002">Garcia Maldonado</persName> y <persName xml:id="cab-001-003_cab-001-003_s002_a003" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s002_a003">Pedro Vazquez</persName>
          <rs xml:id="cab-001-003_cab-001-003_s002_a004" type="role_or_office" subtype="office_or_procedural_role">Alcaldes Ordinarios</rs>.</seg>
        <seg xml:id="cab-001-003_s003" type="juridical_discursive_segment">
          <persName xml:id="cab-001-003_cab-001-003_s003_a001" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s003_a001">Juan de Horosco</persName>, <persName xml:id="cab-001-003_cab-001-003_s003_a002" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s003_a002">Miguel de Trujillo</persName>, <persName xml:id="cab-001-003_cab-001-003_s003_a003" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s003_a003">Hernando de Rojas</persName>
          <rs xml:id="cab-001-003_cab-001-003_s003_a004" type="role_or_office" subtype="office_or_procedural_role">Regidores</rs>, para tratar lo relacionadocon el <term xml:id="cab-001-003_cab-001-003_s003_a005" type="historical_concept" subtype="real_service" ref="https://w3id.org/leco/ontology#RealServiceConcept">real servicio</term>.</seg>
        <seg xml:id="cab-001-003_s004" type="juridical_discursive_segment">En este <orgName xml:id="cab-001-003_cab-001-003_s004_a001" type="cabildo" ref="#org_cab-001-003_cab-001-003_s002_a001">Cabildo</orgName> se tratá por parte de los miembros del <orgName xml:id="cab-001-003_cab-001-003_s004_a002" type="cabildo" ref="#org_cab-001-003_cab-001-003_s004_a002">Cabildo Justicia y Regimiento</orgName>, el contenido de la <rs xml:id="cab-001-003_cab-001-003_s004_a003" type="normativeRule" subtype="letter" ref="#rule_cab-001-003_cab-001-003_s004_a003">carta</rs> enviada por el señor <rs xml:id="cab-001-003_cab-001-003_s004_a004" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#GovernorOfficeType">Gobernador</rs>, donde se estipula el tiempo que ha de permanecer los <term xml:id="cab-001-003_cab-001-003_s004_a005" type="historicalCategory" subtype="colonial_legal_social_category" ref="https://w3id.org/leco/ontology#Indios">indios</term> en sus <rs xml:id="cab-001-003_cab-001-003_s004_a006" type="legal_or_procedural_act" subtype="repartimiento" ana="https://w3id.org/leco/ontology#RepartimientoAct" corresp="#event_cab-001-003_cab-001-003_s004_a006">repartimientos</rs>.</seg>
        <seg xml:id="cab-001-003_s005" type="juridical_discursive_segment">Se <rs xml:id="cab-001-003_cab-001-003_s005_a001" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-003_cab-001-003_s005_a001">acordó</rs> expedir a <persName xml:id="cab-001-003_cab-001-003_s005_a002" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s005_a002">Hernan Suárez</persName> para que se encarguen de los asuntos de losnaturales y los <rs xml:id="cab-001-003_cab-001-003_s005_a003" type="legal_or_procedural_act" subtype="repartimiento" ana="https://w3id.org/leco/ontology#RepartimientoAct" corresp="#event_cab-001-003_cab-001-003_s005_a003">repartimientos</rs>, presente <rs xml:id="cab-001-003_cab-001-003_s005_a004" type="legal_or_procedural_act" subtype="appeal" ana="https://w3id.org/leco/ontology#Appeal" corresp="#event_cab-001-003_cab-001-003_s005_a004">apelación</rs> ante la <orgName xml:id="cab-001-003_cab-001-003_s005_a005" type="audiencia" ref="#org_cab-001-003_cab-001-003_s005_a005">Real Audencia de Santafé</orgName> y los Reinos de <placeName xml:id="cab-001-003_cab-001-003_s005_a006" type="historicalPlace" ref="#place_cab-001-003_cab-001-003_s005_a006">España</placeName>.</seg>
        <seg xml:id="cab-001-003_s006" type="juridical_discursive_segment">Se presento otra <rs xml:id="cab-001-003_cab-001-003_s006_a001" type="normativeRule" subtype="letter" ref="#rule_cab-001-003_cab-001-003_s006_a001">carta</rs> del <orgName xml:id="cab-001-003_cab-001-003_s006_a002" type="cabildo" ref="#org_cab-001-003_cab-001-003_s006_a002">Cabildo de Santafé</orgName>, la cual fue leída, donde se ordena el envío de la respuesta por el <persName xml:id="cab-001-003_cab-001-003_s006_a003" type="historicalPerson" ref="#person_cab-001-003_cab-001-003_s006_a003">Licenciado Santiesteban</persName>.</seg>
        <seg xml:id="cab-001-003_s007" type="juridical_discursive_segment">Se <rs xml:id="cab-001-003_cab-001-003_s007_a001" type="legal_or_procedural_act" subtype="order_event" ana="https://w3id.org/leco/ontology#OrderAct" corresp="#event_cab-001-003_cab-001-003_s007_a001">ordenó</rs>
          <rs xml:id="cab-001-003_cab-001-003_s007_a002" type="legal_or_procedural_act" subtype="proclamation" ana="https://w3id.org/leco/ontology#Proclamation" corresp="#event_cab-001-003_cab-001-003_s007_a002">pregonar</rs> lo acordado.</seg>
      </div>

    <body>
      <div type="acta" xml:id="cab-001-007_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-007_s001" type="juridical_discursive_segment">Los miembros del <orgName xml:id="cab-001-007_cab-001-007_s001_a001" type="cabildo" ref="#org_cab-001-007_cab-001-007_s001_a001">Cabildo</orgName>, <orgName xml:id="cab-001-007_cab-001-007_s001_a002" type="cabildo_body" ref="#org_cab-001-007_cab-001-007_s001_a002">Justicia y Regimiento</orgName> otorgan el <rs xml:id="cab-001-007_cab-001-007_s001_a003" type="legal_or_procedural_act" subtype="grant_of_power" ana="https://w3id.org/leco/ontology#GrantOfPower" corresp="#event_cab-001-007_cab-001-007_s001_a003">poder</rs> de <rs xml:id="cab-001-007_cab-001-007_s001_a004" type="role_or_office" subtype="office_or_procedural_role">Procuradores</rs> a don Pedro de Colemenares y <persName xml:id="cab-001-007_cab-001-007_s001_a005" type="historicalPerson" ref="#person_cab-001-007_cab-001-007_s001_a005">Alonso Tellez</persName>, para que defiendan las causas de la ciudad de <placeName xml:id="cab-001-007_cab-001-007_s001_a006" type="historicalPlace" ref="#place_cab-001-007_cab-001-007_s001_a006">Tunja</placeName>, ante la <orgName xml:id="cab-001-007_cab-001-007_s001_a007" type="audiencia" ref="#org_cab-001-007_cab-001-007_s001_a007">Real Audiencia de Santafé</orgName>, <rs xml:id="cab-001-007_cab-001-007_s001_a008" type="normativeRule" subtype="provision" ref="#rule_cab-001-007_cab-001-007_s001_a008">Provisión</rs> fechada a <date xml:id="cab-001-007_cab-001-007_s001_a009" type="sourceDate">1 de diciembre de 1547</date>.</seg>
        <seg xml:id="cab-001-007_s002" type="juridical_discursive_segment">Dentro de las funciones asignadas, deben realizar <rs xml:id="cab-001-007_cab-001-007_s002_a001" type="legal_or_procedural_act" subtype="supplication" ana="https://w3id.org/leco/ontology#Supplication" corresp="#event_cab-001-007_cab-001-007_s002_a001">suplicas</rs>, <rs xml:id="cab-001-007_cab-001-007_s002_a002" type="legal_or_procedural_act" subtype="appeal" ana="https://w3id.org/leco/ontology#Appeal" corresp="#event_cab-001-007_cab-001-007_s002_a002">apelaciones</rs>, velar por los negocios de la ciudad, dar cumplimiento de las <rs xml:id="cab-001-007_cab-001-007_s002_a003" type="normativeRule" subtype="laws" ref="#rule_cab-001-007_cab-001-007_s002_a003">leyes</rs> de <term xml:id="cab-001-007_cab-001-007_s002_a004" type="historical_concept" subtype="majesty" ref="https://w3id.org/leco/ontology#MajestyConcept">su Magestad</term>, poner remedio a los conflictos de los <term xml:id="cab-001-007_cab-001-007_s002_a005" type="historicalCategory" subtype="colonial_legal_social_category" ref="https://w3id.org/leco/ontology#Naturales">naturales</term> y de los <term xml:id="cab-001-007_cab-001-007_s002_a006" type="historicalCategory" subtype="colonial_social_category" ref="#category_cab-001-007_cab-001-007_s002_a006">colonos</term>, para el bien de los <term xml:id="cab-001-007_cab-001-007_s002_a007" type="historicalCategory" subtype="status_category" ref="https://w3id.org/leco/ontology#Vecinos">vecinos</term> del <placeName xml:id="cab-001-007_cab-001-007_s002_a008" type="historicalPlace" ref="#place_cab-001-007_cab-001-007_s002_a008">Nuevo Reino de Granada</placeName>.</seg>
        <seg xml:id="cab-001-007_s003" type="juridical_discursive_segment">Los miembros del <orgName xml:id="cab-001-007_cab-001-007_s003_a001" type="cabildo" ref="#org_cab-001-007_cab-001-007_s001_a001">cabildo</orgName>, procedieron a tomar el <rs xml:id="cab-001-007_cab-001-007_s003_a002" type="legal_or_procedural_act" subtype="oath" ana="https://w3id.org/leco/ontology#Oath" corresp="#event_cab-001-007_cab-001-007_s003_a002">juramento</rs> de <term xml:id="cab-001-007_cab-001-007_s003_a003" type="historical_concept" subtype="fidelity" ref="https://w3id.org/leco/ontology#FidelityConcept">fidelidad</term> a los dos <rs xml:id="cab-001-007_cab-001-007_s003_a004" type="role_or_office" subtype="office_or_procedural_role">Procuradores Generales</rs> a quienes se les otorgo el <rs xml:id="cab-001-007_cab-001-007_s003_a005" type="legal_or_procedural_act" subtype="power_of_representation" ana="https://w3id.org/leco/ontology#GrantOfPower" corresp="#event_cab-001-007_cab-001-007_s003_a005">poder de representación</rs> y defensa de las causas de la provincia.</seg>
      </div>
    </body>

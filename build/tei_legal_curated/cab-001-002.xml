    <body>
      <div type="acta" xml:id="cab-001-002_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-002_s001" type="juridical_discursive_segment">El día <date xml:id="cab-001-002_cab-001-002_s001_a001" type="sourceDate">2 de septiembre 1547</date>, se reunierón los señores <orgName xml:id="cab-001-002_cab-001-002_s001_a002" type="cabildo_body" ref="#org_cab-001-002_cab-001-002_s001_a002">Justicia y Regimiento</orgName>, con el fin de tratar los asuntos del <term xml:id="cab-001-002_cab-001-002_s001_a003" type="historical_concept" subtype="real_service" ref="https://w3id.org/leco/ontology#RealServiceConcept">Real Servicio</term>.</seg>
        <seg xml:id="cab-001-002_s002" type="juridical_discursive_segment">En la reunión informó el <rs xml:id="cab-001-002_cab-001-002_s002_a001" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#OrdinaryMayorOfficeType">Alcalde Ordinario</rs>, para viajar a las provincias de <placeName xml:id="cab-001-002_cab-001-002_s002_a002" type="historicalPlace" ref="#place_cab-001-002_cab-001-002_s002_a002">Perú</placeName>.</seg>
        <seg xml:id="cab-001-002_s003" type="juridical_discursive_segment">Los señores capitulares, <rs xml:id="cab-001-002_cab-001-002_s003_a001" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-002_cab-001-002_s003_a001">acordaron</rs>
          <rs xml:id="cab-001-002_cab-001-002_s003_a002" type="legal_or_procedural_act" subtype="detention" ana="https://w3id.org/leco/ontology#Detention" corresp="#event_cab-001-002_cab-001-002_s003_a002">ponerlo preso</rs> y encargar en su remplazo a don <persName xml:id="cab-001-002_cab-001-002_s003_a003" type="historicalPerson" ref="#person_cab-001-002_cab-001-002_s003_a003">Pedro Vasquez</persName>.</seg>
        <seg xml:id="cab-001-002_s004" type="juridical_discursive_segment">El <rs xml:id="cab-001-002_cab-001-002_s004_a001" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#MayorOfficeType">Alcalde</rs>
          <persName xml:id="cab-001-002_cab-001-002_s004_a002" type="historicalPerson" ref="#person_cab-001-002_cab-001-002_s004_a002">Juan de Pineda</persName>
          <rs xml:id="cab-001-002_cab-001-002_s004_a003" type="legal_or_procedural_act" subtype="appearance" ana="https://w3id.org/leco/ontology#Appearance" corresp="#event_cab-001-002_cab-001-002_s004_a003">compareció</rs> ante la <orgName xml:id="cab-001-002_cab-001-002_s004_a004" type="audiencia" ref="#org_cab-001-002_cab-001-002_s004_a004">Real Audencia</orgName> para <rs xml:id="cab-001-002_cab-001-002_s004_a005" type="legal_or_procedural_act" subtype="appeal" ana="https://w3id.org/leco/ontology#Appeal" corresp="#event_cab-001-002_cab-001-002_s004_a005">apelar</rs> la sanción, argumento que se encontraba gestionado lo de su <rs xml:id="cab-001-002_cab-001-002_s004_a006" type="legal_or_procedural_act" subtype="appointment" ana="https://w3id.org/leco/ontology#Appointment" corresp="#event_cab-001-002_cab-001-002_s004_a006">nombramiento</rs> como <rs xml:id="cab-001-002_cab-001-002_s004_a007" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#ProcuradorOfficeType">Procurador</rs>.</seg>
        <seg xml:id="cab-001-002_s005" type="juridical_discursive_segment">Se <rs xml:id="cab-001-002_cab-001-002_s005_a001" type="legal_or_procedural_act" subtype="order_event" ana="https://w3id.org/leco/ontology#OrderAct" corresp="#event_cab-001-002_cab-001-002_s005_a001">ordenó</rs>
          <rs xml:id="cab-001-002_cab-001-002_s005_a002" type="legal_or_procedural_act" subtype="investigation" ana="https://w3id.org/leco/ontology#Investigation" corresp="#event_cab-001-002_cab-001-002_s005_a002">investigar</rs> las acciones y comportamiento del señor Pineda, para <rs xml:id="cab-001-002_cab-001-002_s005_a003" type="legal_or_procedural_act" subtype="adjudication" ana="https://w3id.org/leco/ontology#Adjudication" corresp="#event_cab-001-002_cab-001-002_s005_a003">fallar</rs> por su incumplimiento con el <term xml:id="cab-001-002_cab-001-002_s005_a004" type="historical_concept" subtype="duty" ref="https://w3id.org/leco/ontology#DutyConcept">deber</term> de <rs xml:id="cab-001-002_cab-001-002_s005_a005" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#OrdinaryMayorOfficeType">Alcalde Ordinario</rs>.</seg>
      </div>
    </body>

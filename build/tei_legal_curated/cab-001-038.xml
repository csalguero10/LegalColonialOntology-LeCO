    <body>
      <div type="acta" xml:id="cab-001-038_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-038_s001" type="juridical_discursive_segment">En la ciudad de <placeName xml:id="cab-001-038_cab-001-038_s001_a001" type="historicalPlace" ref="#place_cab-001-038_cab-001-038_s001_a001">Tunja</placeName> del <placeName xml:id="cab-001-038_cab-001-038_s001_a002" type="historicalPlace" ref="#place_cab-001-038_cab-001-038_s001_a002">Nuevo Reino de Granada</placeName>, se reunieron los miembros del <orgName xml:id="cab-001-038_cab-001-038_s001_a003" type="cabildo" ref="#org_cab-001-038_cab-001-038_s001_a003">Cabildo</orgName>, el día <date xml:id="cab-001-038_cab-001-038_s001_a004" type="sourceDate">17 de Mayo de 1549</date>.</seg>
        <seg xml:id="cab-001-038_s002" type="juridical_discursive_segment">Se dijo que habia queponer remedio a las personas que estan hechando a perder los montes de esta <term xml:id="cab-001-038_cab-001-038_s002_a001" type="historical_concept" subtype="jurisdiction" ref="https://w3id.org/leco/ontology#JurisdictionConcept">jurisdicción</term>, para lo cual se deben <rs xml:id="cab-001-038_cab-001-038_s002_a002" type="legal_or_procedural_act" subtype="collection" ana="https://w3id.org/leco/ontology#Collection" corresp="#event_cab-001-038_cab-001-038_s002_a002">cobrar</rs>
          <rs xml:id="cab-001-038_cab-001-038_s002_a003" type="legal_or_procedural_act" subtype="fine" ana="https://w3id.org/leco/ontology#Fine" corresp="#event_cab-001-038_cab-001-038_s002_a003">multas</rs>. <date xml:id="cab-001-038_cab-001-038_s002_a004" type="sourceDate">24 mayo 1549</date>.</seg>
        <seg xml:id="cab-001-038_s003" type="juridical_discursive_segment">Don <persName xml:id="cab-001-038_cab-001-038_s003_a001" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s003_a001">Juan de Montalvo</persName> solicita a los señores <orgName xml:id="cab-001-038_cab-001-038_s003_a002" type="cabildo_body" ref="#org_cab-001-038_cab-001-038_s003_a002">Justicia y Regimiento</orgName> un <rs xml:id="cab-001-038_cab-001-038_s003_a003" type="legal_or_procedural_act" subtype="grant_of_power" ana="https://w3id.org/leco/ontology#GrantOfPower" corresp="#event_cab-001-038_cab-001-038_s003_a003">poder</rs> para ocupar el cargo de <rs xml:id="cab-001-038_cab-001-038_s003_a004" type="role_or_office" subtype="office_or_procedural_role">contador</rs> mientras dure la ausencia del titular, quien viajó a la ciudad de <placeName xml:id="cab-001-038_cab-001-038_s003_a005" type="historicalPlace" ref="#place_cab-001-038_cab-001-038_s003_a005">Velez</placeName>.</seg>
        <seg xml:id="cab-001-038_s004" type="juridical_discursive_segment">En este <orgName xml:id="cab-001-038_cab-001-038_s004_a001" type="cabildo" ref="#org_cab-001-038_cab-001-038_s001_a003">Cabildo</orgName> se <rs xml:id="cab-001-038_cab-001-038_s004_a002" type="legal_or_procedural_act" subtype="reading" ana="https://w3id.org/leco/ontology#ReadingAct" corresp="#event_cab-001-038_cab-001-038_s004_a002">leyó</rs> una <rs xml:id="cab-001-038_cab-001-038_s004_a003" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-038_cab-001-038_s004_a003">petición</rs> de Don <persName xml:id="cab-001-038_cab-001-038_s004_a004" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s004_a004">Juan de Chinchilla</persName> quien pide se le <rs xml:id="cab-001-038_cab-001-038_s004_a005" type="legal_or_procedural_act" subtype="land_grant" ana="https://w3id.org/leco/ontology#LandGrant" corresp="#event_cab-001-038_cab-001-038_s004_a005">adjudique</rs> un pedazo de tierra, ubicada junto al Corral de <persName xml:id="cab-001-038_cab-001-038_s004_a006" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s004_a006">Pedro Cordoba</persName>. <date xml:id="cab-001-038_cab-001-038_s004_a007" type="sourceDate">20 octubre 1549</date>
          <orgName xml:id="cab-001-038_cab-001-038_s004_a008" type="cabildo" ref="#org_cab-001-038_cab-001-038_s001_a003">Cabildo</orgName> en el que se <rs xml:id="cab-001-038_cab-001-038_s004_a009" type="legal_or_procedural_act" subtype="reading" ana="https://w3id.org/leco/ontology#ReadingAct" corresp="#event_cab-001-038_cab-001-038_s004_a009">leyó</rs> la <rs xml:id="cab-001-038_cab-001-038_s004_a010" type="normativeRule" subtype="order" ref="#rule_cab-001-038_cab-001-038_s004_a010">orden</rs> del señor <rs xml:id="cab-001-038_cab-001-038_s004_a011" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#GovernorOfficeType">Gobernador</rs> Don <persName xml:id="cab-001-038_cab-001-038_s004_a012" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s004_a012">Miguel Diaz de Armendaris</persName>, para que se se represente en la <orgName xml:id="cab-001-038_cab-001-038_s004_a013" type="audiencia" ref="#org_cab-001-038_cab-001-038_s004_a013">Real Audencia</orgName> el <rs xml:id="cab-001-038_cab-001-038_s004_a014" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#MayorOfficeType">Alcalde</rs>
          <persName xml:id="cab-001-038_cab-001-038_s004_a015" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s004_a015">Gómez de Cifuentes</persName>.</seg>
        <seg xml:id="cab-001-038_s005" type="juridical_discursive_segment">Los miembros del <orgName xml:id="cab-001-038_cab-001-038_s005_a001" type="cabildo" ref="#org_cab-001-038_cab-001-038_s001_a003">Cabildo</orgName>
          <rs xml:id="cab-001-038_cab-001-038_s005_a002" type="legal_or_procedural_act" subtype="obedience" ana="https://w3id.org/leco/ontology#Obedience" corresp="#event_cab-001-038_cab-001-038_s005_a002">obedecieron</rs> y dieron fiel cumplimiento a lo dispuesto por su señoria.</seg>
        <seg xml:id="cab-001-038_s006" type="juridical_discursive_segment">
          <rs xml:id="cab-001-038_cab-001-038_s006_a001" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-038_cab-001-038_s006_a001">Acordaron</rs>
          <rs xml:id="cab-001-038_cab-001-038_s006_a002" type="legal_or_procedural_act" subtype="appointment" ana="https://w3id.org/leco/ontology#Appointment" corresp="#event_cab-001-038_cab-001-038_s006_a002">nombrar</rs> por <rs xml:id="cab-001-038_cab-001-038_s006_a003" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#MayorOfficeType">alcalde</rs> a <persName xml:id="cab-001-038_cab-001-038_s006_a004" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s006_a004">Hernando de Rojas</persName>, mientras donde el titular fuera de <placeName xml:id="cab-001-038_cab-001-038_s006_a005" type="historicalPlace" ref="#place_cab-001-038_cab-001-038_s001_a001">Tunja</placeName>, razón por la cual se <rs xml:id="cab-001-038_cab-001-038_s006_a006" type="legal_or_procedural_act" subtype="order_event" ana="https://w3id.org/leco/ontology#OrderAct" corresp="#event_cab-001-038_cab-001-038_s006_a006">ordenó</rs> realizar los preparativos del recibimiento.</seg>
        <seg xml:id="cab-001-038_s007" type="juridical_discursive_segment">El <date xml:id="cab-001-038_cab-001-038_s007_a001" type="sourceDate">3 de Noviembre de 1549</date> el padre <persName xml:id="cab-001-038_cab-001-038_s007_a002" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s007_a002">Fray Bernardino Minaya de Paz</persName>, <rs xml:id="cab-001-038_cab-001-038_s007_a003" type="legal_or_procedural_act" subtype="presentation" ana="https://w3id.org/leco/ontology#Presentation" corresp="#event_cab-001-038_cab-001-038_s007_a003">presentó</rs> una <rs xml:id="cab-001-038_cab-001-038_s007_a004" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-038_cab-001-038_s007_a004">petición</rs> y un libro de la <rs xml:id="cab-001-038_cab-001-038_s007_a005" type="normativeRule" subtype="papal_bull" ref="#rule_cab-001-038_cab-001-038_s007_a005">bula</rs> del <persName xml:id="cab-001-038_cab-001-038_s007_a006" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s007_a006">papa Julio</persName>, en la que da fé el <rs xml:id="cab-001-038_cab-001-038_s007_a007" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#BishopOfficeType">obispo</rs> de Austria <rs xml:id="cab-001-038_cab-001-038_s007_a008" type="role_or_office" subtype="office_or_procedural_role">cardenal</rs> de <persName xml:id="cab-001-038_cab-001-038_s007_a009" type="historicalPerson" ref="#person_cab-001-038_cab-001-038_s007_a009">San Jorge</persName>, en lo referente a la <rs xml:id="cab-001-038_cab-001-038_s007_a010" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-038_cab-001-038_s007_a010">petición</rs>, solicitud la <rs xml:id="cab-001-038_cab-001-038_s007_a011" type="normativeRule" subtype="order" ref="#rule_cab-001-038_cab-001-038_s007_a011">orden</rs> para la fundación del Monasterio de la ciudad de <placeName xml:id="cab-001-038_cab-001-038_s007_a012" type="historicalPlace" ref="#place_cab-001-038_cab-001-038_s001_a001">Tunja</placeName>.</seg>
      </div>
    </body>

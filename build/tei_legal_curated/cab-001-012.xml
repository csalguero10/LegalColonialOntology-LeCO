  <text>
    <body>
      <div type="acta" xml:id="cab-001-012_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-012_s001" type="juridical_discursive_segment">
          <orgName xml:id="cab-001-012_cab-001-012_s001_a001" type="cabildo" ref="#org_cab-001-012_cab-001-012_s001_a001">Cabildo</orgName> del <date xml:id="cab-001-012_cab-001-012_s001_a002" type="sourceDate">6 de Junio 1549</date> en el que se reunieron los señores <orgName xml:id="cab-001-012_cab-001-012_s001_a003" type="cabildo_body" ref="#org_cab-001-012_cab-001-012_s001_a003">Justicia y Regimiento</orgName> para tratar los asuntos del <term xml:id="cab-001-012_cab-001-012_s001_a004" type="historical_concept" subtype="real_service" ref="https://w3id.org/leco/ontology#RealServiceConcept">Real Servicio</term>.</seg>
        <seg xml:id="cab-001-012_s002" type="juridical_discursive_segment">En la reunión se trató lo relacionado a la <rs xml:id="cab-001-012_cab-001-012_s002_a001" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-012_cab-001-012_s002_a001">petición</rs> presentada por <persName xml:id="cab-001-012_cab-001-012_s002_a002" type="historicalPerson" ref="#person_cab-001-012_cab-001-012_s002_a002">Francisco Martinez</persName>, quien solicita la <rs xml:id="cab-001-012_cab-001-012_s002_a003" type="legal_or_procedural_act" subtype="land_grant" ana="https://w3id.org/leco/ontology#LandGrant" corresp="#event_cab-001-012_cab-001-012_s002_a003">adjudicación</rs> de un pedazo de tierra en <placeName xml:id="cab-001-012_cab-001-012_s002_a004" type="historicalPlace" ref="#place_cab-001-012_cab-001-012_s002_a004">Sipatá</placeName> se <rs xml:id="cab-001-012_cab-001-012_s002_a005" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-012_cab-001-012_s002_a005">acordó</rs> proveerla <rs xml:id="cab-001-012_cab-001-012_s002_a006" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-012_cab-001-012_s002_a006">petición</rs>, siempre y cuando no fuera lesivo para los <term xml:id="cab-001-012_cab-001-012_s002_a007" type="historicalCategory" subtype="status_category" ref="https://w3id.org/leco/ontology#Vecinos">vecinos</term> de <placeName xml:id="cab-001-012_cab-001-012_s002_a008" type="historicalPlace" ref="#place_cab-001-012_cab-001-012_s002_a008">Tunja</placeName>, ni para el paso de las yeguas al pueblo.</seg>
        <seg xml:id="cab-001-012_s003" type="juridical_discursive_segment">También se <rs xml:id="cab-001-012_cab-001-012_s003_a001" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-012_cab-001-012_s003_a001">acordó</rs> mandar a los <term xml:id="cab-001-012_cab-001-012_s003_a002" type="historicalCategory" subtype="status_category" ref="https://w3id.org/leco/ontology#Vecinos">vecinos</term> hierrantes no pasar con los caballos por dichas tierras, so <rs xml:id="cab-001-012_cab-001-012_s003_a003" type="legal_or_procedural_act" subtype="penalty" ana="https://w3id.org/leco/ontology#Sanction" corresp="#event_cab-001-012_cab-001-012_s003_a003">pena</rs> de $10 pesos; se <rs xml:id="cab-001-012_cab-001-012_s003_a004" type="legal_or_procedural_act" subtype="order_event" ana="https://w3id.org/leco/ontology#OrderAct" corresp="#event_cab-001-012_cab-001-012_s003_a004">ordenó</rs>
          <rs xml:id="cab-001-012_cab-001-012_s003_a005" type="legal_or_procedural_act" subtype="proclamation" ana="https://w3id.org/leco/ontology#Proclamation" corresp="#event_cab-001-012_cab-001-012_s003_a005">pregonar</rs> la <rs xml:id="cab-001-012_cab-001-012_s003_a006" type="normativeRule" subtype="order" ref="#rule_cab-001-012_cab-001-012_s003_a006">orden</rs>.</seg>
        <seg xml:id="cab-001-012_s004" type="juridical_discursive_segment">En el <orgName xml:id="cab-001-012_cab-001-012_s004_a001" type="cabildo" ref="#org_cab-001-012_cab-001-012_s001_a001">cabildo</orgName>, <rs xml:id="cab-001-012_cab-001-012_s004_a002" type="legal_or_procedural_act" subtype="approval" ana="https://w3id.org/leco/ontology#Approval" corresp="#event_cab-001-012_cab-001-012_s004_a002">aprobaron</rs>
          <rs xml:id="cab-001-012_cab-001-012_s004_a003" type="legal_or_procedural_act" subtype="collection" ana="https://w3id.org/leco/ontology#Collection" corresp="#event_cab-001-012_cab-001-012_s004_a003">cobrar</rs> medio peso del buen oro, por cada vaca, yegua que se encontrara haciendo daño en las sementeras y en el sementerio.</seg>
        <seg xml:id="cab-001-012_s005" type="juridical_discursive_segment">
          <date xml:id="cab-001-012_cab-001-012_s005_a001" type="sourceDate">15 de Junio de 1549</date>, fecha en laque se dió cumplimiento al <rs xml:id="cab-001-012_cab-001-012_s005_a002" type="legal_or_procedural_act" subtype="proclamation" ana="https://w3id.org/leco/ontology#Proclamation" corresp="#event_cab-001-012_cab-001-012_s005_a002">pregón</rs> ordenado en el <orgName xml:id="cab-001-012_cab-001-012_s005_a003" type="cabildo" ref="#org_cab-001-012_cab-001-012_s001_a001">Cabildo</orgName> del día <date xml:id="cab-001-012_cab-001-012_s005_a004" type="sourceDate">6 de Junio 1549</date>.</seg>
        <seg xml:id="cab-001-012_s006" type="juridical_discursive_segment">
          <placeName xml:id="cab-001-012_cab-001-012_s006_a001" type="historicalPlace" ref="#place_cab-001-012_cab-001-012_s002_a008">Tunja</placeName>, <date xml:id="cab-001-012_cab-001-012_s006_a002" type="sourceDate">23 junio 1549</date>, <orgName xml:id="cab-001-012_cab-001-012_s006_a003" type="cabildo" ref="#org_cab-001-012_cab-001-012_s001_a001">Cabildo</orgName> en el que se confiere un <rs xml:id="cab-001-012_cab-001-012_s006_a004" type="legal_or_procedural_act" subtype="grant_of_power" ana="https://w3id.org/leco/ontology#GrantOfPower" corresp="#event_cab-001-012_cab-001-012_s006_a004">poder</rs> al <rs xml:id="cab-001-012_cab-001-012_s006_a005" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#MayorOfficeType">Alcalde Ordinario</rs>
          <persName xml:id="cab-001-012_cab-001-012_s006_a006" type="historicalPerson" ref="#person_cab-001-012_cab-001-012_s006_a006">Juan de Orozco</persName> para que defienda las causas y negocios de la Ciudad en la <orgName xml:id="cab-001-012_cab-001-012_s006_a007" type="audiencia" ref="#org_cab-001-012_cab-001-012_s006_a007">Real Audencia</orgName>.</seg>
      </div>
    </body>

  <text>
    <body>
      <div type="acta" xml:id="cab-001-040_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-040_s001" type="juridical_discursive_segment">En la ciudad de <placeName xml:id="cab-001-040_cab-001-040_s001_a001" type="historicalPlace" ref="#place_cab-001-040_cab-001-040_s001_a001">Tunja</placeName>, a <date xml:id="cab-001-040_cab-001-040_s001_a002" type="sourceDate">19 noviembre de 1549</date> se reunieron los miembros del <orgName xml:id="cab-001-040_cab-001-040_s001_a003" type="cabildo" ref="#org_cab-001-040_cab-001-040_s001_a003">Cabildo</orgName> en la casa del señor <persName xml:id="cab-001-040_cab-001-040_s001_a004" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s001_a004">Gómez de Cifuentes</persName>.</seg>
        <seg xml:id="cab-001-040_s002" type="juridical_discursive_segment">Allí se <rs xml:id="cab-001-040_cab-001-040_s002_a001" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-040_cab-001-040_s002_a001">acordó</rs> enviar señores de la ciudad a <placeName xml:id="cab-001-040_cab-001-040_s002_a002" type="historicalPlace" ref="#place_cab-001-040_cab-001-040_s002_a002">Santafé</placeName>, para pedir los propios; se <rs xml:id="cab-001-040_cab-001-040_s002_a003" type="legal_or_procedural_act" subtype="decision" ana="https://w3id.org/leco/ontology#LegalDecision" corresp="#event_cab-001-040_cab-001-040_s002_a003">acordó</rs> enviar a Don <persName xml:id="cab-001-040_cab-001-040_s002_a004" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s002_a004">Domingo de Aguirre</persName>.</seg>
        <seg xml:id="cab-001-040_s003" type="juridical_discursive_segment">Los señores <orgName xml:id="cab-001-040_cab-001-040_s003_a001" type="cabildo_body" ref="#org_cab-001-040_cab-001-040_s003_a001">Justicia y Regimiento</orgName> en nombre del <orgName xml:id="cab-001-040_cab-001-040_s003_a002" type="cabildo" ref="#org_cab-001-040_cab-001-040_s001_a003">Cabildo</orgName> de la ciudad de <placeName xml:id="cab-001-040_cab-001-040_s003_a003" type="historicalPlace" ref="#place_cab-001-040_cab-001-040_s001_a001">Tunja</placeName> y sus <term xml:id="cab-001-040_cab-001-040_s003_a004" type="historicalCategory" subtype="status_category" ref="https://w3id.org/leco/ontology#Vecinos">vecinos</term> dan todo su <rs xml:id="cab-001-040_cab-001-040_s003_a005" type="legal_or_procedural_act" subtype="grant_of_power" ana="https://w3id.org/leco/ontology#GrantOfPower" corresp="#event_cab-001-040_cab-001-040_s003_a005">poder</rs> cumplido a <persName xml:id="cab-001-040_cab-001-040_s003_a006" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a006">Miguel de Trujillo</persName> vecino y <rs xml:id="cab-001-040_cab-001-040_s003_a007" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#CorregidorOfficeType">corregidor</rs> de esta ciudad, se <rs xml:id="cab-001-040_cab-001-040_s003_a008" type="legal_or_procedural_act" subtype="order_event" ana="https://w3id.org/leco/ontology#OrderAct" corresp="#event_cab-001-040_cab-001-040_s003_a008">ordenó</rs>
          <rs xml:id="cab-001-040_cab-001-040_s003_a009" type="legal_or_procedural_act" subtype="proclamation" ana="https://w3id.org/leco/ontology#Proclamation" corresp="#event_cab-001-040_cab-001-040_s003_a009">pregonar</rs> la decisión en la plaza principal en prueba de testimonio dieron fé y firmaron: <persName xml:id="cab-001-040_cab-001-040_s003_a010" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a010">Cabrera</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a011" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a011">Cifuentes</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a012" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a012">Suárez</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a013" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a013">Orozco</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a014" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a014">Rojas</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a015" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a015">Beteita</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a016" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a016">Trujillo</persName>, <persName xml:id="cab-001-040_cab-001-040_s003_a017" type="historicalPerson" ref="#person_cab-001-040_cab-001-040_s003_a017">Aguirre</persName>.</seg>
      </div>
    </body>

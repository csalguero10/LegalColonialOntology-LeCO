    <body>
      <div type="acta" xml:id="cab-001-039_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-039_s001" type="juridical_discursive_segment">
          <placeName xml:id="cab-001-039_cab-001-039_s001_a001" type="historicalPlace" ref="#place_cab-001-039_cab-001-039_s001_a001">Tunja</placeName>, <date xml:id="cab-001-039_cab-001-039_s001_a002" type="sourceDate">4 de Noviembre de 1549</date>.</seg>
        <seg xml:id="cab-001-039_s002" type="juridical_discursive_segment">Don <persName xml:id="cab-001-039_cab-001-039_s002_a001" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s002_a001">Diego de Robles</persName>
          <rs xml:id="cab-001-039_cab-001-039_s002_a002" type="legal_or_procedural_act" subtype="notification" ana="https://w3id.org/leco/ontology#Notification" corresp="#event_cab-001-039_cab-001-039_s002_a002">notificó</rs> la <rs xml:id="cab-001-039_cab-001-039_s002_a003" type="normativeRule" subtype="order" ref="#rule_cab-001-039_cab-001-039_s002_a003">orden</rs> al Padre <persName xml:id="cab-001-039_cab-001-039_s002_a004" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s002_a004">Fray Diego Mynaya</persName>, en la se autoriza la construción de Monasterio.</seg>
        <seg xml:id="cab-001-039_s003" type="juridical_discursive_segment">Después, a los 10 dias del mes de noviembre del mismo año, ante el noble señor <persName xml:id="cab-001-039_cab-001-039_s003_a001" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a001">Alonso de Cabrera</persName>
          <rs xml:id="cab-001-039_cab-001-039_s003_a002" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#MayorOfficeType">Alcalde Ordinario</rs> de <placeName xml:id="cab-001-039_cab-001-039_s003_a003" type="historicalPlace" ref="#place_cab-001-039_cab-001-039_s001_a001">Tunja</placeName> se <rs xml:id="cab-001-039_cab-001-039_s003_a004" type="legal_or_procedural_act" subtype="presentation" ana="https://w3id.org/leco/ontology#Presentation" corresp="#event_cab-001-039_cab-001-039_s003_a004">presentó</rs>
          <persName xml:id="cab-001-039_cab-001-039_s003_a005" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a005">Fray Bernardino</persName> quien mostró la <rs xml:id="cab-001-039_cab-001-039_s003_a006" type="normativeRule" subtype="provision" ref="#rule_cab-001-039_cab-001-039_s003_a006">provisión</rs> para la construcción del Monasterio del señor San Salvador, firmaron por testigos y dieran fe: <rs xml:id="cab-001-039_cab-001-039_s003_a007" type="role_or_office" subtype="office_or_procedural_role">Cap</rs>
          <persName xml:id="cab-001-039_cab-001-039_s003_a008" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a008">Gonzalo Suárez</persName>, el <rs xml:id="cab-001-039_cab-001-039_s003_a009" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#CaptainOfficeType">capitan</rs>
          <persName xml:id="cab-001-039_cab-001-039_s003_a010" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a010">Baltazar Maldonado</persName>, <persName xml:id="cab-001-039_cab-001-039_s003_a011" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a011">Hernando de Rojas</persName> y <persName xml:id="cab-001-039_cab-001-039_s003_a012" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a012">Pedro Rodriguez</persName>.</seg>
        <seg xml:id="cab-001-039_s004" type="juridical_discursive_segment">En la ciudad, el dia <date xml:id="cab-001-039_cab-001-039_s004_a001" type="sourceDate">14 de Noviembre 1549</date>, se pregonó las <rs xml:id="cab-001-039_cab-001-039_s004_a002" type="normativeRule" subtype="new_laws" ref="#rule_cab-001-039_cab-001-039_s004_a002">nuevas leyes</rs> y <rs xml:id="cab-001-039_cab-001-039_s004_a003" type="normativeRule" subtype="royal_ordinances" ref="#rule_cab-001-039_cab-001-039_s004_a003">ordenanzas Reales</rs> para el <term xml:id="cab-001-039_cab-001-039_s004_a004" type="historical_concept" subtype="common_good" ref="https://w3id.org/leco/ontology#CommonGoodConcept">bien del Reino</term> y de la <term xml:id="cab-001-039_cab-001-039_s004_a005" type="historical_concept" subtype="republic" ref="https://w3id.org/leco/ontology#RepublicConcept">República</term>.</seg>
        <seg xml:id="cab-001-039_s005" type="juridical_discursive_segment">En este <orgName xml:id="cab-001-039_cab-001-039_s005_a001" type="cabildo" ref="#org_cab-001-039_cab-001-039_s005_a001">Cabildo</orgName>
          <persName xml:id="cab-001-039_cab-001-039_s005_a002" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s003_a011">Hernando de Rojas</persName>
          <rs xml:id="cab-001-039_cab-001-039_s005_a003" type="officeType" subtype="office_or_procedural_role" ref="https://w3id.org/leco/ontology#RegidorOfficeType">Regidor</rs>
          <rs xml:id="cab-001-039_cab-001-039_s005_a004" type="legal_or_procedural_act" subtype="presentation" ana="https://w3id.org/leco/ontology#Presentation" corresp="#event_cab-001-039_cab-001-039_s005_a004">presentó</rs> una <rs xml:id="cab-001-039_cab-001-039_s005_a005" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-039_cab-001-039_s005_a005">petición</rs> en la que solicita se la haga <rs xml:id="cab-001-039_cab-001-039_s005_a006" type="legal_or_procedural_act" subtype="grant" ana="https://w3id.org/leco/ontology#AdministrativeAct" corresp="#event_cab-001-039_cab-001-039_s005_a006">merced</rs> de un Hegido en términos de la ciudad con el fin de hacer un molino de aguas frontero de un tejar los capituladores <rs xml:id="cab-001-039_cab-001-039_s005_a007" type="legal_or_procedural_act" subtype="approval" ana="https://w3id.org/leco/ontology#Approval" corresp="#event_cab-001-039_cab-001-039_s005_a007">aprobaron</rs> la <rs xml:id="cab-001-039_cab-001-039_s005_a008" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-039_cab-001-039_s005_a008">petición</rs>.</seg>
        <seg xml:id="cab-001-039_s006" type="juridical_discursive_segment">En dicha reunión se vió otra <rs xml:id="cab-001-039_cab-001-039_s006_a001" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-039_cab-001-039_s006_a001">petición</rs>, presentaba por <persName xml:id="cab-001-039_cab-001-039_s006_a002" type="historicalPerson" ref="#person_cab-001-039_cab-001-039_s006_a002">Sebastian Martin</persName> vecino de <placeName xml:id="cab-001-039_cab-001-039_s006_a003" type="historicalPlace" ref="#place_cab-001-039_cab-001-039_s001_a001">Tunja</placeName>, quien pide se le dé un solar cerca al arroyo de la ciudad.</seg>
        <seg xml:id="cab-001-039_s007" type="juridical_discursive_segment">En este <orgName xml:id="cab-001-039_cab-001-039_s007_a001" type="cabildo" ref="#org_cab-001-039_cab-001-039_s005_a001">Cabildo</orgName> los <orgName xml:id="cab-001-039_cab-001-039_s007_a002" type="cabildo_body" ref="#org_cab-001-039_cab-001-039_s007_a002">Justicia y Regimiento</orgName> dijeron que se mirara el precio del trigo, con el fin de subir el costo.</seg>
      </div>
    </body>
  </text>

  <text>
    <body>
      <div type="acta" xml:id="cab-001-055_acta" ana="https://w3id.org/leco/ontology#ActaCabildoDocumentType">
        <seg xml:id="cab-001-055_s001" type="juridical_discursive_segment">
          <placeName xml:id="cab-001-055_cab-001-055_s001_a001" type="historicalPlace" ref="#place_cab-001-055_cab-001-055_s001_a001">Tunja</placeName>, <date xml:id="cab-001-055_cab-001-055_s001_a002" type="sourceDate">7 de Noviembre 1550</date>.</seg>
        <seg xml:id="cab-001-055_s002" type="juridical_discursive_segment">Se llevó a cabo otra reunión del <orgName xml:id="cab-001-055_cab-001-055_s002_a001" type="cabildo" ref="#org_cab-001-055_cab-001-055_s002_a001">Cabildo</orgName>, en la que se <rs xml:id="cab-001-055_cab-001-055_s002_a002" type="legal_or_procedural_act" subtype="presentation" ana="https://w3id.org/leco/ontology#Presentation" corresp="#event_cab-001-055_cab-001-055_s002_a002">presentó</rs> ua <rs xml:id="cab-001-055_cab-001-055_s002_a003" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-055_cab-001-055_s002_a003">petición</rs> de <persName xml:id="cab-001-055_cab-001-055_s002_a004" type="historicalPerson" ref="#person_cab-001-055_cab-001-055_s002_a004">Martin Sanchez Ropero</persName>, quien pide un sitio para construir un molino cerca al puente del camino, real.</seg>
        <seg xml:id="cab-001-055_s003" type="juridical_discursive_segment">Tambien sepresentó otra <rs xml:id="cab-001-055_cab-001-055_s003_a001" type="legal_or_procedural_act" subtype="petition" ana="https://w3id.org/leco/ontology#Petition" corresp="#event_cab-001-055_cab-001-055_s003_a001">petición</rs> por parte de <persName xml:id="cab-001-055_cab-001-055_s003_a002" type="historicalPerson" ref="#person_cab-001-055_cab-001-055_s003_a002">Hernando Rojas</persName>, quien solicita unas tierras para ganados mayor en términos de <placeName xml:id="cab-001-055_cab-001-055_s003_a003" type="historicalPlace" ref="#place_cab-001-055_cab-001-055_s001_a001">Tunja</placeName>.</seg>
        <seg xml:id="cab-001-055_s004" type="juridical_discursive_segment">Los señores <orgName xml:id="cab-001-055_cab-001-055_s004_a001" type="cabildo_body" ref="#org_cab-001-055_cab-001-055_s004_a001">Justicia y Regimiento</orgName>
          <rs xml:id="cab-001-055_cab-001-055_s004_a002" type="legal_or_procedural_act" subtype="approval" ana="https://w3id.org/leco/ontology#Approval" corresp="#event_cab-001-055_cab-001-055_s004_a002">aprobaron</rs> los titulos de tierra solicitados, siempre y cuando no existan problemas con los <term xml:id="cab-001-055_cab-001-055_s004_a003" type="historicalCategory" subtype="colonial_legal_social_category" ref="https://w3id.org/leco/ontology#Naturales">naturales</term> ó terceros.</seg>
        <seg xml:id="cab-001-055_s005" type="juridical_discursive_segment">Se <rs xml:id="cab-001-055_cab-001-055_s005_a001" type="legal_or_procedural_act" subtype="order_event" ana="https://w3id.org/leco/ontology#OrderAct" corresp="#event_cab-001-055_cab-001-055_s005_a001">ordenó</rs> dar al <rs xml:id="cab-001-055_cab-001-055_s005_a002" type="legal_or_procedural_act" subtype="proclamation" ana="https://w3id.org/leco/ontology#Proclamation" corresp="#event_cab-001-055_cab-001-055_s005_a002">pregón</rs> en la plaza principal.</seg>
        <seg xml:id="cab-001-055_s006" type="juridical_discursive_segment">En este <orgName xml:id="cab-001-055_cab-001-055_s006_a001" type="cabildo" ref="#org_cab-001-055_cab-001-055_s002_a001">Cabildo</orgName>, se <rs xml:id="cab-001-055_cab-001-055_s006_a002" type="legal_or_procedural_act" subtype="approval" ana="https://w3id.org/leco/ontology#Approval" corresp="#event_cab-001-055_cab-001-055_s006_a002">aprobó</rs>
          <rs xml:id="cab-001-055_cab-001-055_s006_a003" type="legal_or_procedural_act" subtype="collection" ana="https://w3id.org/leco/ontology#Collection" corresp="#event_cab-001-055_cab-001-055_s006_a003">cobrar</rs> $40 pesos del buen oro en cada un año por los propios de la ciudad, en constancia firmaron los capituladores.</seg>
      </div>

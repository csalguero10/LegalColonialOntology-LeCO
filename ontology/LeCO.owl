  <rdf:Description rdf:about="https://w3id.org/leco/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/leco/ontology/0.3.0"/>
    <owl:versionInfo>0.3.0</owl:versionInfo>
    <dcterms:title xml:lang="en">LegalColonialOntology (LeCO)</dcterms:title>
    <dcterms:title xml:lang="es">Ontología Jurídica Colonial (LeCO)</dcterms:title>
    <dcterms:description xml:lang="es">Ontología de dominio para representar la cultura jurisdiccional, los documentos, normas, actores, cargos, roles procesales, actos, jurisdicciones, categorías jurídico-sociales y conceptos históricos de fuentes jurídicas coloniales iberoamericanas.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-28</dcterms:created>
    <dcterms:conformsTo rdf:resource="https://www.ica.org/standards/RiC/ontology"/>
    <dcterms:conformsTo rdf:resource="http://www.cidoc-crm.org/cidoc-crm/"/>
    <dcterms:conformsTo rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/ns/prov#"/>
    <dcterms:conformsTo rdf:resource="http://www.w3.org/2006/time#"/>
    <rdfs:comment xml:lang="es">Versión 0.3 con gaps de Competency Questions resueltos para el corpus piloto de cabildos. El namespace w3id.org es el namespace propuesto por el proyecto; su redirección deberá configurarse antes de la publicación web.</rdfs:comment>
  </rdf:Description>

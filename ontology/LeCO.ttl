leco:NotaryOfficeType a leco:OfficeType ; skos:prefLabel "Escribano"@es ; skos:broader leco:JudicialOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:DeputyOfficeType a leco:OfficeType ; skos:prefLabel "Diputado"@es ; skos:broader leco:AdministrativeOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:LieutenantOfficeType a leco:OfficeType ; skos:prefLabel "Teniente"@es ; skos:broader leco:AdministrativeOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:BailiffOfficeType a leco:OfficeType ; skos:prefLabel "Alguacil"@es ; skos:altLabel "Alquacil"@es ; skos:broader leco:JudicialOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:ChiefBailiffOfficeType a leco:OfficeType ; skos:prefLabel "Alguacil Mayor"@es ; skos:altLabel "Alquacil Mayor"@es ; skos:broader leco:BailiffOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:OidorOfficeType a leco:OfficeType ; skos:prefLabel "Oidor"@es ; skos:broader leco:JudicialOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:CommissionJudgeOfficeType a leco:OfficeType ; skos:prefLabel "Juez de Comisión"@es ; skos:broader leco:JudicialOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:JudgeOfficeType a leco:OfficeType ; skos:prefLabel "Juez"@es ; skos:broader leco:JudicialOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:AccountantOfficeType a leco:OfficeType ; skos:prefLabel "Contador"@es ; skos:broader leco:FiscalOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .
leco:CorregidorOfficeType a leco:OfficeType ; skos:prefLabel "Corregidor"@es ; skos:broader leco:AdministrativeOfficeType , leco:JudicialOfficeType ; skos:inScheme leco:OfficeTypeScheme ; leco:sourceStatus "observed-in-pilot" .

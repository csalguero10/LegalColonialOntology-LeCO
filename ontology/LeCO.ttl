@prefix leco: <https://w3id.org/leco/ontology#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology metadata
#################################################################

<https://w3id.org/leco/ontology>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/leco/ontology/0.3.0> ;
    owl:versionInfo "0.3.0" ;
    dcterms:title "LegalColonialOntology (LeCO)"@en ;
    dcterms:title "Ontología Jurídica Colonial (LeCO)"@es ;
    dcterms:description "Ontología de dominio para representar la cultura jurisdiccional, los documentos, normas, actores, cargos, roles procesales, actos, jurisdicciones, categorías jurídico-sociales y conceptos históricos de fuentes jurídicas coloniales iberoamericanas."@es ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:conformsTo <https://www.ica.org/standards/RiC/ontology> ,
        <http://www.cidoc-crm.org/cidoc-crm/> ,
        <http://xmlns.com/foaf/0.1/> ,
        <http://www.w3.org/2004/02/skos/core> ,
        <http://www.w3.org/ns/prov#> ,
        <http://www.w3.org/2006/time#> ;
    rdfs:comment "Versión 0.3 con gaps de Competency Questions resueltos para el corpus piloto de cabildos. El namespace w3id.org es el namespace propuesto por el proyecto; su redirección deberá configurarse antes de la publicación web."@es .

#################################################################
# Annotation properties
#################################################################

leco:sourceStatus a owl:AnnotationProperty ;
    rdfs:label "estado de procedencia conceptual"@es ;
    rdfs:comment "Indica si una categoría fue observada en el corpus piloto o incorporada como concepto semilla desde la literatura."@es .

leco:modelingNote a owl:AnnotationProperty ;
    rdfs:label "nota de modelado"@es .

#################################################################
# 1. Documentary layer
#################################################################

leco:LegalDocument a owl:Class ;
    rdfs:label "Documento jurídico"@es , "Legal Document"@en ;
    rdfs:subClassOf rico:Record , crm:E31_Document , prov:Entity ;
    rdfs:comment "Documento que desempeña una función jurídica, normativa, administrativa, procesal o jurisdiccional."@es .

leco:LegalDocumentPart a owl:Class ;
    rdfs:label "Parte de documento jurídico"@es , "Legal Document Part"@en ;
    rdfs:subClassOf rico:RecordPart , prov:Entity .

leco:NormativeDocument a owl:Class ;
    rdfs:label "Documento normativo"@es , "Normative Document"@en ;
    rdfs:subClassOf leco:LegalDocument ;
    rdfs:comment "Documento que expresa o evidencia una regla o mandato. No debe confundirse con la regla misma."@es .

leco:DocumentType a owl:Class ;
    rdfs:label "Tipo documental"@es , "Document Type"@en ;
    rdfs:subClassOf rico:DocumentaryFormType , skos:Concept .

#################################################################
# 2. Normative layer: rules are distinct from documents
#################################################################

leco:NormativeRule a owl:Class ;
    rdfs:label "Regla normativa"@es , "Normative Rule"@en ;
    rdfs:subClassOf rico:Rule ;
    rdfs:comment "Regla, escrita o no escrita, relevante para el orden normativo colonial. Puede estar expresada en uno o varios documentos."@es .

leco:JurisdictionalMandate a owl:Class ;
    rdfs:label "Mandato jurisdiccional"@es , "Jurisdictional Mandate"@en ;
    rdfs:subClassOf leco:NormativeRule , rico:Mandate ;
    rdfs:comment "Mandato que confiere autoridad, responsabilidad o competencia para una actividad dentro de un ámbito jurisdiccional."@es .

leco:LegalDuty a owl:Class ;
    rdfs:label "Deber jurídico"@es , "Legal Duty"@en ;
    rdfs:subClassOf leco:NormativeRule .

#################################################################
# 3. Jurisdictional acts and events
#################################################################

leco:JurisdictionalAct a owl:Class ;
    rdfs:label "Acto jurisdiccional"@es , "Jurisdictional Act"@en ;
    rdfs:subClassOf rico:Activity , crm:E7_Activity , prov:Activity ;
    rdfs:comment "Actividad históricamente situada realizada en ejercicio, aplicación, negociación o contexto de jurisdicción."@es .

leco:ProceduralAct a owl:Class ;
    rdfs:label "Acto procesal"@es , "Procedural Act"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:LegalProceeding a owl:Class ;
    rdfs:label "Procedimiento jurídico"@es , "Legal Proceeding"@en ;
    rdfs:subClassOf rico:Activity , crm:E7_Activity , prov:Activity ;
    rdfs:comment "Actividad procesal compleja que agrupa actuaciones relacionadas dentro de un mismo procedimiento, causa o trámite."@es .

leco:AdministrativeAct a owl:Class ;
    rdfs:label "Acto administrativo"@es , "Administrative Act"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:NormativeAct a owl:Class ;
    rdfs:label "Acto normativo"@es , "Normative Act"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:LegalDecision a owl:Class ;
    rdfs:label "Decisión jurídica"@es , "Legal Decision"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:EnforcementAct a owl:Class ;
    rdfs:label "Acto de ejecución"@es , "Enforcement Act"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:CommunicationAct a owl:Class ;
    rdfs:label "Acto de comunicación jurídica"@es , "Legal Communication Act"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:FormalAct a owl:Class ;
    rdfs:label "Acto formal"@es , "Formal Act"@en ;
    rdfs:subClassOf leco:JurisdictionalAct .

leco:FiscalAct a owl:Class ;
    rdfs:label "Acto fiscal"@es , "Fiscal Act"@en ;
    rdfs:subClassOf leco:AdministrativeAct .

# Procedural acts observed or required by the pilot
leco:Petition a owl:Class ; rdfs:label "Petición"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .
leco:Appeal a owl:Class ; rdfs:label "Apelación"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .
leco:Appearance a owl:Class ; rdfs:label "Comparecencia"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .
leco:Presentation a owl:Class ; rdfs:label "Presentación"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .
leco:Supplication a owl:Class ; rdfs:label "Súplica"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .
leco:Testimony a owl:Class ; rdfs:label "Testimonio"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "seed-from-methodology" .
leco:Opposition a owl:Class ; rdfs:label "Oposición"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "seed-from-methodology" .
leco:Investigation a owl:Class ; rdfs:label "Investigación"@es ; rdfs:subClassOf leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .
leco:Notification a owl:Class ; rdfs:label "Notificación"@es ; rdfs:subClassOf leco:CommunicationAct , leco:ProceduralAct ; leco:sourceStatus "observed-in-pilot" .

# Decisions
leco:OrderAct a owl:Class ; rdfs:label "Orden (acto)"@es ; rdfs:subClassOf leco:LegalDecision ; leco:sourceStatus "observed-in-pilot" .
leco:Approval a owl:Class ; rdfs:label "Aprobación"@es ; rdfs:subClassOf leco:LegalDecision ; leco:sourceStatus "observed-in-pilot" .
leco:Adjudication a owl:Class ; rdfs:label "Fallo / adjudicación decisoria"@es ; rdfs:subClassOf leco:LegalDecision ; leco:sourceStatus "observed-in-pilot" .
leco:Sanction a owl:Class ; rdfs:label "Sanción"@es ; rdfs:subClassOf leco:LegalDecision ; leco:sourceStatus "observed-in-pilot" .
leco:Fine a owl:Class ; rdfs:label "Multa"@es ; rdfs:subClassOf leco:Sanction ; leco:sourceStatus "observed-in-pilot" .
leco:Detention a owl:Class ; rdfs:label "Detención"@es ; rdfs:subClassOf leco:Sanction ; leco:sourceStatus "observed-in-pilot" .
leco:Punishment a owl:Class ; rdfs:label "Castigo"@es ; rdfs:subClassOf leco:Sanction ; leco:sourceStatus "observed-in-pilot" .
leco:Prohibition a owl:Class ; rdfs:label "Prohibición"@es ; rdfs:subClassOf leco:LegalDecision ; leco:sourceStatus "observed-in-pilot" .

# Administrative and other acts
leco:Appointment a owl:Class ; rdfs:label "Nombramiento"@es ; rdfs:subClassOf leco:AdministrativeAct ; leco:sourceStatus "observed-in-pilot" .
leco:LandGrant a owl:Class ; rdfs:label "Adjudicación de tierra"@es ; rdfs:subClassOf leco:AdministrativeAct ; leco:sourceStatus "observed-in-pilot" .
leco:AuctionAward a owl:Class ; rdfs:label "Remate"@es ; rdfs:subClassOf leco:AdministrativeAct ; leco:sourceStatus "observed-in-pilot" .
leco:Collection a owl:Class ; rdfs:label "Cobro"@es ; rdfs:subClassOf leco:FiscalAct ; leco:sourceStatus "observed-in-pilot" .
leco:Proclamation a owl:Class ; rdfs:label "Pregón"@es ; rdfs:subClassOf leco:CommunicationAct ; leco:sourceStatus "observed-in-pilot" .
leco:ReadingAct a owl:Class ; rdfs:label "Lectura pública o jurídica"@es ; rdfs:subClassOf leco:CommunicationAct ; leco:sourceStatus "observed-in-pilot" .
leco:Oath a owl:Class ; rdfs:label "Juramento"@es ; rdfs:subClassOf leco:FormalAct ; leco:sourceStatus "observed-in-pilot" .
leco:Obedience a owl:Class ; rdfs:label "Obedecimiento / acatamiento"@es ; rdfs:subClassOf leco:FormalAct ; leco:sourceStatus "observed-in-pilot" .
leco:Execution a owl:Class ; rdfs:label "Ejecución"@es ; rdfs:subClassOf leco:EnforcementAct ; leco:sourceStatus "observed-in-pilot" .

#################################################################
# 4. Jurisdiction
#################################################################

leco:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdicción"@es , "Jurisdiction"@en ;
    rdfs:comment "Ámbito históricamente definido de potestad o competencia. LeCO no reduce la jurisdicción a un lugar: puede incluir alcance territorial, personal y material."@es .

leco:TerritorialJurisdiction a owl:Class ;
    rdfs:label "Jurisdicción territorial"@es ;
    rdfs:subClassOf leco:Jurisdiction .

leco:PersonalJurisdiction a owl:Class ;
    rdfs:label "Jurisdicción personal"@es ;
    rdfs:subClassOf leco:Jurisdiction .

leco:SubjectMatterJurisdiction a owl:Class ;
    rdfs:label "Jurisdicción material"@es ;
    rdfs:subClassOf leco:Jurisdiction .

leco:MixedJurisdiction a owl:Class ;
    rdfs:label "Jurisdicción mixta"@es ;
    rdfs:subClassOf leco:Jurisdiction .

#################################################################
# 5. Agents, offices, roles, participation and institutions
#################################################################

leco:Office a owl:Class ;
    rdfs:label "Oficio o cargo"@es , "Office"@en ;
    rdfs:subClassOf rico:Position ;
    rdfs:comment "Posición institucional que existe independientemente de la persona que la ocupa."@es .

leco:OfficeType a owl:Class ;
    rdfs:label "Tipo de oficio"@es ;
    rdfs:subClassOf rico:Type , skos:Concept .

leco:ProceduralRole a owl:Class ;
    rdfs:label "Rol procesal"@es , "Procedural Role"@en ;
    rdfs:subClassOf rico:RoleType , crm:E55_Type , skos:Concept ;
    owl:disjointWith leco:Office .

leco:InstitutionType a owl:Class ;
    rdfs:label "Tipo institucional"@es ;
    rdfs:subClassOf rico:CorporateBodyType , skos:Concept .

leco:JusticeAndRegimentBody a owl:Class ;
    rdfs:label "Cuerpo de Justicia y Regimiento"@es ;
    rdfs:subClassOf rico:CorporateBody ;
    leco:modelingNote "Dimensión institucional concreta de la expresión histórica Justicia y Regimiento; se mantiene además un concepto SKOS de tipo institucional."@es .

leco:Participation a owl:Class ;
    rdfs:label "Participación procesal o jurisdiccional"@es ;
    rdfs:subClassOf prov:Association ;
    rdfs:comment "Nodo n-ario para contextualizar un actor, un acto y el rol desempeñado en ese acto."@es .

#################################################################
# 6. Historical concepts and historical legal/social categories
#################################################################

leco:HistoricalLegalConcept a owl:Class ;
    rdfs:label "Concepto jurídico histórico"@es ;
    rdfs:subClassOf rico:Concept , skos:Concept .

leco:HistoricalConceptUse a owl:Class ;
    rdfs:label "Uso histórico de concepto"@es ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "Representa una ocurrencia contextualizada de un concepto histórico, preservando forma léxica, documento, temporalidad, jurisdicción y significado interpretado."@es .

leco:HistoricalLegalCategory a owl:Class ;
    rdfs:label "Categoría jurídico-histórica"@es ;
    rdfs:subClassOf rico:Type , skos:Concept ;
    rdfs:comment "Categoría atribuida por fuentes históricas a personas o colectivos; no debe interpretarse automáticamente como clasificación contemporánea."@es .

leco:EthnoLegalCategory a owl:Class ;
    rdfs:label "Categoría etno-jurídica"@es ;
    rdfs:subClassOf leco:HistoricalLegalCategory .

leco:StatusCategory a owl:Class ;
    rdfs:label "Categoría de estatus"@es ;
    rdfs:subClassOf leco:HistoricalLegalCategory .

leco:ReligiousLegalCategory a owl:Class ;
    rdfs:label "Categoría jurídico-religiosa"@es ;
    rdfs:subClassOf leco:HistoricalLegalCategory .

leco:SocioLegalCategory a owl:Class ;
    rdfs:label "Categoría socio-jurídica"@es ;
    rdfs:subClassOf leco:HistoricalLegalCategory .

leco:ColonialOfficeStatus a owl:Class ;
    rdfs:label "Estatus colonial vinculado a oficio, privilegio o función"@es ;
    rdfs:subClassOf leco:HistoricalLegalCategory .

leco:HistoricalCategoryAssignment a owl:Class ;
    rdfs:label "Atribución de categoría histórica"@es ;
    rdfs:subClassOf crm:E13_Attribute_Assignment , prov:Entity ;
    rdfs:comment "Permite afirmar que una fuente histórica atribuye una categoría a un actor, preservando quién/qué la atribuye y la evidencia documental."@es .

#################################################################
# 7. Legal argumentation and legal relations
#################################################################

leco:LegalArgument a owl:Class ;
    rdfs:label "Argumento jurídico"@es ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

leco:LegalRelation a owl:Class ;
    rdfs:label "Relación jurídica"@es ;
    rdfs:subClassOf rico:Relation .

leco:RepresentationRelation a owl:Class ;
    rdfs:label "Relación de representación"@es ;
    rdfs:subClassOf leco:LegalRelation ;
    leco:modelingNote "Dimensión relacional del poder de representación."@es .

leco:LegalArrangement a owl:Class ;
    rdfs:label "Arreglo o institución jurídica"@es ;
    rdfs:comment "Configuración jurídica o institucional que puede resultar de una práctica o acto sin reducirse al evento que la produjo."@es .

leco:LegalEntitlement a owl:Class ;
    rdfs:label "Derecho o beneficio jurídico"@es ;
    rdfs:subClassOf crm:E30_Right .

#################################################################
# 8. Explicit dual/multiple-nature cases
#################################################################

# AUTO: decision/event + documentary type
leco:AutoDecision a owl:Class ;
    rdfs:label "Auto (decisión/acto)"@es ;
    rdfs:subClassOf leco:LegalDecision ;
    leco:modelingNote "No confundir con leco:AutoDocumentType."@es .

# PROCURADOR: office type + procedural role (SKOS individuals below)

# JUSTICIA Y REGIMIENTO: body class + institution type (SKOS individual below)

# REPARTIMIENTO: act + resulting regime/arrangement
leco:RepartimientoAct a owl:Class ;
    rdfs:label "Repartimiento (acto/práctica)"@es ;
    rdfs:subClassOf leco:AdministrativeAct ;
    leco:sourceStatus "observed-in-pilot" .

leco:RepartimientoRegime a owl:Class ;
    rdfs:label "Repartimiento (régimen/arreglo jurídico)"@es ;
    rdfs:subClassOf leco:LegalArrangement .

# MERCED: act + resulting benefit/right
leco:MercedGrant a owl:Class ;
    rdfs:label "Merced (acto de concesión)"@es ;
    rdfs:subClassOf leco:AdministrativeAct ;
    leco:sourceStatus "observed-in-pilot" .

leco:MercedBenefit a owl:Class ;
    rdfs:label "Merced (derecho o beneficio concedido)"@es ;
    rdfs:subClassOf leco:LegalEntitlement .

# PODER: act + representation relation + documentary type
leco:GrantOfPower a owl:Class ;
    rdfs:label "Otorgamiento de poder"@es ;
    rdfs:subClassOf leco:ProceduralAct , leco:AdministrativeAct ;
    leco:sourceStatus "observed-in-pilot" .

#################################################################
# 9. Semantic annotation / AI provenance layer
#################################################################

leco:SemanticAnnotation a owl:Class ;
    rdfs:label "Anotación semántica"@es ;
    rdfs:subClassOf prov:Entity .

leco:AnnotationActivity a owl:Class ;
    rdfs:label "Actividad de anotación"@es ;
    rdfs:subClassOf prov:Activity .

leco:AIAnnotationActivity a owl:Class ;
    rdfs:label "Actividad de anotación mediante IA"@es ;
    rdfs:subClassOf leco:AnnotationActivity .

leco:HumanValidationActivity a owl:Class ;
    rdfs:label "Actividad de validación humana"@es ;
    rdfs:subClassOf leco:AnnotationActivity .

leco:ValidationStatus a owl:Class ;
    rdfs:label "Estado de validación"@es ;
    rdfs:subClassOf skos:Concept .

leco:AnnotationBasis a owl:Class ;
    rdfs:label "Base de anotación"@es , "Annotation Basis"@en ;
    rdfs:subClassOf skos:Concept ;
    rdfs:comment "Clasifica si una anotación deriva de evidencia textual explícita, inferencia, metadatos de catálogo u otra base interpretativa."@es .

#################################################################
# 10. Object properties
#################################################################

# Documentary typing and relation to rules/activities
leco:hasDocumentType a owl:ObjectProperty ;
    rdfs:label "tiene tipo documental"@es ;
    rdfs:subPropertyOf rico:hasDocumentaryFormType ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:LegalDocument leco:LegalDocumentPart) ] ;
    rdfs:range leco:DocumentType .

leco:documentsAct a owl:ObjectProperty ;
    rdfs:label "documenta acto"@es ;
    rdfs:subPropertyOf rico:documents ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:LegalDocument leco:LegalDocumentPart) ] ;
    rdfs:range leco:JurisdictionalAct .

leco:expressesRule a owl:ObjectProperty ;
    rdfs:label "expresa regla"@es ;
    rdfs:subPropertyOf rico:expressesOrExpressed ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:LegalDocument leco:LegalDocumentPart) ] ;
    rdfs:range leco:NormativeRule .

leco:invokesRule a owl:ObjectProperty ;
    rdfs:label "invoca regla"@es ;
    rdfs:subPropertyOf rico:isAssociatedWithRule ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:JurisdictionalAct leco:LegalArgument) ] ;
    rdfs:range rico:Rule .

leco:argumentInvokesRule a owl:ObjectProperty ;
    rdfs:label "argumento invoca regla"@es ;
    rdfs:subPropertyOf leco:invokesRule ;
    rdfs:domain leco:LegalArgument ;
    rdfs:range leco:NormativeRule .

leco:citesRule a owl:ObjectProperty ;
    rdfs:label "cita regla"@es ;
    rdfs:subPropertyOf leco:invokesRule ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:JurisdictionalAct leco:LegalArgument) ] ;
    rdfs:range leco:NormativeRule .

leco:appliesRule a owl:ObjectProperty ;
    rdfs:label "aplica regla"@es ;
    rdfs:subPropertyOf leco:invokesRule ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range leco:NormativeRule .

leco:interpretsRule a owl:ObjectProperty ;
    rdfs:label "interpreta regla"@es ;
    rdfs:subPropertyOf leco:invokesRule ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:JurisdictionalAct leco:LegalArgument) ] ;
    rdfs:range leco:NormativeRule .

# Participation
leco:hasParticipation a owl:ObjectProperty ;
    rdfs:label "tiene participación"@es ;
    rdfs:subPropertyOf prov:qualifiedAssociation ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range leco:Participation .

leco:participationActor a owl:ObjectProperty ;
    rdfs:label "actor de la participación"@es ;
    rdfs:subPropertyOf prov:agent ;
    rdfs:domain leco:Participation ;
    rdfs:range rico:Agent .

leco:participationRole a owl:ObjectProperty ;
    rdfs:label "rol de la participación"@es ;
    rdfs:subPropertyOf prov:hadRole ;
    rdfs:domain leco:Participation ;
    rdfs:range leco:ProceduralRole .

leco:participationInAct a owl:ObjectProperty ;
    rdfs:label "participación en acto"@es ;
    rdfs:domain leco:Participation ;
    rdfs:range leco:JurisdictionalAct .

leco:hasParticipant a owl:ObjectProperty ;
    rdfs:label "tiene participante"@es ;
    rdfs:subPropertyOf crm:P11_had_participant ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range rico:Agent ;
    rdfs:comment "Atajo. Para roles procesales contextualizados se recomienda leco:Participation."@es .

# Proceedings and adversarial structure
leco:hasProceduralAct a owl:ObjectProperty ;
    rdfs:label "tiene acto procesal"@es ;
    rdfs:subPropertyOf rico:hasDirectSubevent ;
    rdfs:domain leco:LegalProceeding ;
    rdfs:range leco:ProceduralAct ;
    owl:inverseOf leco:inProceeding .

leco:inProceeding a owl:ObjectProperty ;
    rdfs:label "pertenece a procedimiento"@es ;
    rdfs:subPropertyOf rico:isDirectSubeventOf ;
    rdfs:domain leco:ProceduralAct ;
    rdfs:range leco:LegalProceeding .

leco:opposesParticipation a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "se opone procesalmente a participación"@es ;
    rdfs:domain leco:Participation ;
    rdfs:range leco:Participation ;
    rdfs:comment "Relaciona participaciones procesales enfrentadas dentro de un mismo procedimiento sin convertir la oposición en una cualidad permanente de las personas."@es .

# Offices and institutions
leco:holdsOffice a owl:ObjectProperty ;
    rdfs:label "ocupa oficio"@es ;
    rdfs:subPropertyOf rico:occupiesOrOccupied ;
    rdfs:domain rico:Person ;
    rdfs:range leco:Office .

leco:officeExistsIn a owl:ObjectProperty ;
    rdfs:label "oficio existe en institución"@es ;
    rdfs:subPropertyOf rico:existsOrExistedIn ;
    rdfs:domain leco:Office ;
    rdfs:range rico:Group .

leco:hasOfficeType a owl:ObjectProperty ;
    rdfs:label "tiene tipo de oficio"@es ;
    rdfs:subPropertyOf rico:hasOrHadCategory ;
    rdfs:domain leco:Office ;
    rdfs:range leco:OfficeType .

leco:hasInstitutionType a owl:ObjectProperty ;
    rdfs:label "tiene tipo institucional"@es ;
    rdfs:subPropertyOf rico:hasOrHadCorporateBodyType ;
    rdfs:domain rico:CorporateBody ;
    rdfs:range leco:InstitutionType .

# Jurisdiction
leco:exercisesJurisdiction a owl:ObjectProperty ;
    rdfs:label "ejerce jurisdicción"@es ;
    rdfs:domain rico:Agent ;
    rdfs:range leco:Jurisdiction ;
    owl:inverseOf leco:jurisdictionExercisedBy .

leco:jurisdictionExercisedBy a owl:ObjectProperty ;
    rdfs:label "jurisdicción ejercida por"@es ;
    rdfs:domain leco:Jurisdiction ;
    rdfs:range rico:Agent .

leco:withinJurisdiction a owl:ObjectProperty ;
    rdfs:label "dentro de jurisdicción"@es ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range leco:Jurisdiction .

leco:appliesWithinJurisdiction a owl:ObjectProperty ;
    rdfs:label "aplica dentro de jurisdicción"@es ;
    rdfs:domain leco:NormativeRule ;
    rdfs:range leco:Jurisdiction ;
    rdfs:comment "Expresa el ámbito jurisdiccional de aplicación de una regla sin reducirlo a un simple lugar geográfico."@es .

leco:territorialScope a owl:ObjectProperty ;
    rdfs:label "ámbito territorial"@es ;
    rdfs:domain leco:Jurisdiction ;
    rdfs:range rico:Place .

leco:personalScope a owl:ObjectProperty ;
    rdfs:label "ámbito personal"@es ;
    rdfs:domain leco:Jurisdiction ;
    rdfs:range leco:HistoricalLegalCategory .

leco:subjectMatterScope a owl:ObjectProperty ;
    rdfs:label "ámbito material"@es ;
    rdfs:domain leco:Jurisdiction ;
    rdfs:range leco:HistoricalLegalConcept .

# Procedural / decisional relations
leco:decidedBy a owl:ObjectProperty ;
    rdfs:label "decidido por"@es ;
    rdfs:subPropertyOf crm:P14_carried_out_by ;
    rdfs:domain leco:LegalDecision ;
    rdfs:range rico:Agent .

leco:beforeAuthority a owl:ObjectProperty ;
    rdfs:label "ante autoridad"@es ;
    rdfs:domain leco:ProceduralAct ;
    rdfs:range rico:Agent .

leco:appealsAgainst a owl:ObjectProperty ;
    rdfs:label "apela contra"@es ;
    rdfs:domain leco:Appeal ;
    rdfs:range leco:LegalDecision .

leco:respondsTo a owl:ObjectProperty ;
    rdfs:label "responde a"@es ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range leco:JurisdictionalAct .

leco:ordersAct a owl:ObjectProperty ;
    rdfs:label "ordena acto"@es ;
    rdfs:domain leco:OrderAct ;
    rdfs:range leco:JurisdictionalAct .

leco:hasObjectOfAct a owl:ObjectProperty ;
    rdfs:label "tiene objeto del acto"@es ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range owl:Thing .

leco:sanctions a owl:ObjectProperty ;
    rdfs:label "sanciona a"@es ;
    rdfs:domain leco:Sanction ;
    rdfs:range rico:Agent .

leco:investigates a owl:ObjectProperty ;
    rdfs:label "investiga"@es ;
    rdfs:domain leco:Investigation ;
    rdfs:range owl:Thing .

leco:appointsPerson a owl:ObjectProperty ;
    rdfs:label "nombra persona"@es ;
    rdfs:domain leco:Appointment ;
    rdfs:range rico:Person .

leco:appointsToOffice a owl:ObjectProperty ;
    rdfs:label "nombra para oficio"@es ;
    rdfs:domain leco:Appointment ;
    rdfs:range leco:Office .

leco:replacesPerson a owl:ObjectProperty ;
    rdfs:label "reemplaza a persona"@es ;
    rdfs:domain leco:Appointment ;
    rdfs:range rico:Person .

# Argumentation and concepts
leco:hasLegalArgument a owl:ObjectProperty ;
    rdfs:label "tiene argumento jurídico"@es ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range leco:LegalArgument .

leco:usesHistoricalConcept a owl:ObjectProperty ;
    rdfs:label "usa concepto histórico"@es ;
    rdfs:range leco:HistoricalLegalConcept .

leco:conceptUsed a owl:ObjectProperty ;
    rdfs:label "concepto utilizado"@es ;
    rdfs:domain leco:HistoricalConceptUse ;
    rdfs:range leco:HistoricalLegalConcept .

leco:attestedIn a owl:ObjectProperty ;
    rdfs:label "atestiguado en"@es ;
    rdfs:domain [ a owl:Class ; owl:unionOf (leco:HistoricalConceptUse leco:HistoricalCategoryAssignment leco:SemanticAnnotation) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf (leco:LegalDocument leco:LegalDocumentPart) ] .

leco:conceptUseJurisdiction a owl:ObjectProperty ;
    rdfs:label "jurisdicción del uso conceptual"@es ;
    rdfs:domain leco:HistoricalConceptUse ;
    rdfs:range leco:Jurisdiction .

leco:conceptUseTime a owl:ObjectProperty ;
    rdfs:label "contexto temporal del uso conceptual"@es ;
    rdfs:domain leco:HistoricalConceptUse ;
    rdfs:range time:TemporalEntity .

# Historical category assignment
leco:assignsHistoricalCategory a owl:ObjectProperty ;
    rdfs:label "asigna categoría histórica"@es ;
    rdfs:domain leco:HistoricalCategoryAssignment ;
    rdfs:range leco:HistoricalLegalCategory .

leco:categoryAssignedTo a owl:ObjectProperty ;
    rdfs:label "categoría asignada a"@es ;
    rdfs:domain leco:HistoricalCategoryAssignment ;
    rdfs:range rico:Agent .

leco:categoryAssignmentJurisdiction a owl:ObjectProperty ;
    rdfs:label "jurisdicción de atribución categorial"@es ;
    rdfs:domain leco:HistoricalCategoryAssignment ;
    rdfs:range leco:Jurisdiction .

leco:categoryAssignmentTime a owl:ObjectProperty ;
    rdfs:label "contexto temporal de atribución categorial"@es ;
    rdfs:domain leco:HistoricalCategoryAssignment ;
    rdfs:range time:TemporalEntity .

leco:categoryAssignmentInAct a owl:ObjectProperty ;
    rdfs:label "atribución categorial en acto"@es ;
    rdfs:domain leco:HistoricalCategoryAssignment ;
    rdfs:range leco:JurisdictionalAct .

leco:classifiedAsHistoricalCategory a owl:ObjectProperty ;
    rdfs:label "clasificado en la fuente como"@es ;
    rdfs:domain rico:Agent ;
    rdfs:range leco:HistoricalLegalCategory ;
    rdfs:comment "Atajo para consulta. Cuando sea posible debe acompañarse de una instancia de HistoricalCategoryAssignment que preserve evidencia y contexto."@es .

# Dual-nature relations
leco:resultsInLegalArrangement a owl:ObjectProperty ;
    rdfs:label "resulta en arreglo jurídico"@es ;
    rdfs:domain leco:JurisdictionalAct ;
    rdfs:range leco:LegalArrangement .

leco:resultsInEntitlement a owl:ObjectProperty ;
    rdfs:label "resulta en derecho o beneficio"@es ;
    rdfs:domain leco:MercedGrant ;
    rdfs:range leco:LegalEntitlement .

leco:grantedTo a owl:ObjectProperty ;
    rdfs:label "concedido a"@es ;
    rdfs:domain leco:LegalEntitlement ;
    rdfs:range rico:Agent .

leco:createsRepresentation a owl:ObjectProperty ;
    rdfs:label "crea relación de representación"@es ;
    rdfs:domain leco:GrantOfPower ;
    rdfs:range leco:RepresentationRelation .

leco:principal a owl:ObjectProperty ;
    rdfs:label "poderdante / representado"@es ;
    rdfs:domain leco:RepresentationRelation ;
    rdfs:range rico:Agent .

leco:representative a owl:ObjectProperty ;
    rdfs:label "representante / apoderado"@es ;
    rdfs:domain leco:RepresentationRelation ;
    rdfs:range rico:Agent .

leco:representationScope a owl:ObjectProperty ;
    rdfs:label "alcance de representación"@es ;
    rdfs:domain leco:RepresentationRelation ;
    rdfs:range owl:Thing .

# Annotation/provenance
leco:annotationTarget a owl:ObjectProperty ;
    rdfs:label "objetivo de anotación"@es ;
    rdfs:domain leco:SemanticAnnotation ;
    rdfs:range prov:Entity .

leco:annotationBody a owl:ObjectProperty ;
    rdfs:label "contenido semántico de anotación"@es ;
    rdfs:domain leco:SemanticAnnotation ;
    rdfs:range owl:Thing .

leco:hasValidationStatus a owl:ObjectProperty ;
    rdfs:label "tiene estado de validación"@es ;
    rdfs:domain leco:SemanticAnnotation ;
    rdfs:range leco:ValidationStatus .

leco:annotationBasis a owl:ObjectProperty ;
    rdfs:label "tiene base de anotación"@es ;
    rdfs:domain leco:SemanticAnnotation ;
    rdfs:range leco:AnnotationBasis .

#################################################################
# 11. Datatype properties
#################################################################

leco:lexicalForm a owl:DatatypeProperty ;
    rdfs:label "forma léxica"@es ;
    rdfs:range xsd:string .

leco:normalizedForm a owl:DatatypeProperty ;
    rdfs:label "forma normalizada"@es ;
    rdfs:range xsd:string .

leco:historicalMeaningNote a owl:DatatypeProperty ;
    rdfs:label "nota de significado histórico"@es ;
    rdfs:domain leco:HistoricalConceptUse ;
    rdfs:range xsd:string .

leco:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "nivel de confianza"@es ;
    rdfs:domain leco:SemanticAnnotation ;
    rdfs:range xsd:decimal .

leco:evidenceText a owl:DatatypeProperty ;
    rdfs:label "texto de evidencia"@es ;
    rdfs:range xsd:string .

leco:validationNote a owl:DatatypeProperty ;
    rdfs:label "nota de validación"@es ;
    rdfs:domain leco:SemanticAnnotation ;
    rdfs:range xsd:string .

#################################################################
# 12. SKOS concept schemes
#################################################################

leco:InstitutionTypeScheme a skos:ConceptScheme ; skos:prefLabel "Tipos institucionales de LeCO"@es .
leco:OfficeTypeScheme a skos:ConceptScheme ; skos:prefLabel "Tipos de oficio de LeCO"@es .
leco:ProceduralRoleScheme a skos:ConceptScheme ; skos:prefLabel "Roles procesales de LeCO"@es .
leco:DocumentTypeScheme a skos:ConceptScheme ; skos:prefLabel "Tipos documentales de LeCO"@es .
leco:HistoricalLegalConceptScheme a skos:ConceptScheme ; skos:prefLabel "Conceptos jurídico-históricos de LeCO"@es .
leco:HistoricalLegalCategoryScheme a skos:ConceptScheme ; skos:prefLabel "Categorías jurídico-históricas de LeCO"@es .
leco:EthnoLegalCategoryScheme a skos:ConceptScheme ; skos:prefLabel "Subvocabulario de categorías etno-jurídicas"@es .
leco:StatusCategoryScheme a skos:ConceptScheme ; skos:prefLabel "Subvocabulario de categorías de estatus"@es .
leco:ReligiousLegalCategoryScheme a skos:ConceptScheme ; skos:prefLabel "Subvocabulario de categorías jurídico-religiosas"@es .
leco:SocioLegalCategoryScheme a skos:ConceptScheme ; skos:prefLabel "Subvocabulario de categorías socio-jurídicas"@es .
leco:ColonialOfficeStatusScheme a skos:ConceptScheme ; skos:prefLabel "Subvocabulario de estatus coloniales vinculados a oficio, privilegio o función"@es .
leco:ValidationStatusScheme a skos:ConceptScheme ; skos:prefLabel "Estados de validación de anotaciones"@es .
leco:AnnotationBasisScheme a skos:ConceptScheme ; skos:prefLabel "Bases de anotación de LeCO"@es .

#################################################################
# 12b. Annotation basis vocabulary
#################################################################

leco:ExplicitTextualEvidence a leco:AnnotationBasis ;
    skos:prefLabel "evidencia textual explícita"@es ;
    skos:inScheme leco:AnnotationBasisScheme .

leco:InferredFromText a leco:AnnotationBasis ;
    skos:prefLabel "inferencia a partir del texto"@es ;
    skos:inScheme leco:AnnotationBasisScheme .

leco:CatalogMetadataBasis a leco:AnnotationBasis ;
    skos:prefLabel "metadatos de catálogo"@es ;
    skos:inScheme leco:AnnotationBasisScheme .

leco:HumanInterpretationBasis a leco:AnnotationBasis ;
    skos:prefLabel "interpretación historiográfica humana"@es ;
    skos:inScheme leco:AnnotationBasisScheme .


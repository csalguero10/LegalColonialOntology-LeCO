leco:AudienciaType a leco:InstitutionType ; skos:prefLabel "Audiencia"@es ; skos:altLabel "Corte"@es ; skos:inScheme leco:InstitutionTypeScheme ; leco:sourceStatus "observed-in-pilot" .

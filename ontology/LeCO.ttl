leco:GovernorateType a leco:InstitutionType ; skos:prefLabel "Gobernación"@es ; skos:inScheme leco:InstitutionTypeScheme ; leco:sourceStatus "seed-from-literature" .
leco:ViceroyaltyType a leco:InstitutionType ; skos:prefLabel "Virreinato"@es ; skos:inScheme leco:InstitutionTypeScheme ; leco:sourceStatus "seed-from-literature" .


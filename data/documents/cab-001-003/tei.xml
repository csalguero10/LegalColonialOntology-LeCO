        <body>
            <div type="acta" xml:id="cab-001-003_acta">
                <seg xml:id="cab-001-003_s001" type="juridical_discursive_segment"><date
                        xml:id="cab-001-003_cab-001-003_s001_a001" type="sourceDate">3 de Septiembre
                    de 1547</date>.</seg>
                <seg xml:id="cab-001-003_s002" type="juridical_discursive_segment">En este <orgName
                        xml:id="cab-001-003_cab-001-003_s002_a001" type="cabildo">Cabildo</orgName>
                    se reunierón los señores <persName xml:id="cab-001-003_cab-001-003_s002_a002"
                        type="historicalPerson">Garcia Maldonado</persName> y <persName
                        xml:id="cab-001-003_cab-001-003_s002_a003" type="historicalPerson">Pedro
                    Vazquez</persName> <rs xml:id="cab-001-003_cab-001-003_s002_a004"
                        type="role_or_office" subtype="office_or_procedural_role">Alcaldes
                    Ordinarios</rs>.</seg>
                <seg xml:id="cab-001-003_s003" type="juridical_discursive_segment"><persName
                        xml:id="cab-001-003_cab-001-003_s003_a001" type="historicalPerson">Juan de
                    Horosco</persName>, <persName xml:id="cab-001-003_cab-001-003_s003_a002"
                        type="historicalPerson">Miguel de Trujillo</persName>, <persName
                        xml:id="cab-001-003_cab-001-003_s003_a003" type="historicalPerson">Hernando
                    de Rojas</persName> <rs xml:id="cab-001-003_cab-001-003_s003_a004"
                        type="role_or_office" subtype="office_or_procedural_role">Regidores</rs>,
                    para tratar lo relacionadocon el <term
                        xml:id="cab-001-003_cab-001-003_s003_a005" type="historical_concept"
                        subtype="real_service">real servicio</term>.</seg>
                <seg xml:id="cab-001-003_s004" type="juridical_discursive_segment">En este <orgName
                        xml:id="cab-001-003_cab-001-003_s004_a001" type="cabildo">Cabildo</orgName>
                    se tratá por parte de los miembros del <orgName
                        xml:id="cab-001-003_cab-001-003_s004_a002" type="cabildo">Cabildo Justicia y
                    Regimiento</orgName>, el contenido de la <rs
                        xml:id="cab-001-003_cab-001-003_s004_a003" type="normative_source"
                        subtype="letter">carta</rs> enviada por el señor <rs
                        xml:id="cab-001-003_cab-001-003_s004_a004" type="role_or_office"
                        subtype="office_or_procedural_role">Gobernador</rs>, donde se estipula el
                    tiempo que ha de permanecer los <term xml:id="cab-001-003_cab-001-003_s004_a005"
                        type="historical_social_legal_category"
                        subtype="colonial_legal_social_category">indios</term> en sus <rs
                        xml:id="cab-001-003_cab-001-003_s004_a006" type="legal_or_procedural_act"
                        subtype="repartimiento">repartimientos</rs>.</seg>
                <seg xml:id="cab-001-003_s005" type="juridical_discursive_segment">Se <rs
                        xml:id="cab-001-003_cab-001-003_s005_a001" type="legal_or_procedural_act"
                        subtype="decision">acordó</rs> expedir a <persName
                        xml:id="cab-001-003_cab-001-003_s005_a002" type="historicalPerson">Hernan
                    Suárez</persName> para que se encarguen de los asuntos de losnaturales y los <rs
                        xml:id="cab-001-003_cab-001-003_s005_a003" type="legal_or_procedural_act"
                        subtype="repartimiento">repartimientos</rs>, presente <rs
                        xml:id="cab-001-003_cab-001-003_s005_a004" type="legal_or_procedural_act"
                        subtype="appeal">apelación</rs> ante la <orgName
                        xml:id="cab-001-003_cab-001-003_s005_a005" type="audiencia">Real Audencia de
                    Santafé</orgName> y los Reinos de <placeName
                        xml:id="cab-001-003_cab-001-003_s005_a006" type="historicalPlace">España</placeName>
                    .</seg>
                <seg xml:id="cab-001-003_s006" type="juridical_discursive_segment">Se presento otra <rs
                        xml:id="cab-001-003_cab-001-003_s006_a001" type="normative_source"
                        subtype="letter">carta</rs> del <orgName
                        xml:id="cab-001-003_cab-001-003_s006_a002" type="cabildo">Cabildo de Santafé</orgName>,
                    la cual fue leída, donde se ordena el envío de la respuesta por el <persName
                        xml:id="cab-001-003_cab-001-003_s006_a003" type="historicalPerson">Licenciado
                    Santiesteban</persName>.</seg>
                <seg xml:id="cab-001-003_s007" type="juridical_discursive_segment">Se <rs
                        xml:id="cab-001-003_cab-001-003_s007_a001" type="legal_or_procedural_act"
                        subtype="order_event">ordenó</rs> <rs
                        xml:id="cab-001-003_cab-001-003_s007_a002" type="legal_or_procedural_act"
                        subtype="proclamation">pregonar</rs> lo acordado.</seg>
            </div>
        </body>

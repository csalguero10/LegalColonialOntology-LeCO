        <body>
            <div type="acta" xml:id="cab-001-004_acta">
                <seg xml:id="cab-001-004_s001" type="juridical_discursive_segment"><placeName
                        xml:id="cab-001-004_cab-001-004_s001_a001" type="historicalPlace">Tunja</placeName>
                    , <date xml:id="cab-001-004_cab-001-004_s001_a002" type="sourceDate">26 de
                    Septimbre 1547</date>.</seg>
                <seg xml:id="cab-001-004_s002" type="juridical_discursive_segment">En este <orgName
                        xml:id="cab-001-004_cab-001-004_s002_a001" type="cabildo">Cabildo</orgName>
                    los señores <orgName xml:id="cab-001-004_cab-001-004_s002_a002"
                        type="cabildo_body">Justicia y Regimiento</orgName> dijeron que por el <rs
                        xml:id="cab-001-004_cab-001-004_s002_a003" type="legal_or_procedural_act"
                        subtype="proclamation">pregón</rs> de un <rs
                        xml:id="cab-001-004_cab-001-004_s002_a004" type="normative_source"
                        subtype="auto">auto</rs> que se realizó, donde se <rs
                        xml:id="cab-001-004_cab-001-004_s002_a005" type="legal_or_procedural_act"
                        subtype="order_event">mandó</rs> hacer la despedida del señor <rs
                        xml:id="cab-001-004_cab-001-004_s002_a006" type="role_or_office"
                        subtype="office_or_procedural_role">Gobernador</rs> por parte de los <term
                        xml:id="cab-001-004_cab-001-004_s002_a007"
                        type="historical_social_legal_category" subtype="status_category">vecinos</term>
                    del <rs xml:id="cab-001-004_cab-001-004_s002_a008"
                        type="legal_or_procedural_act" subtype="repartimiento">Repartimiento</rs>,
                    ya no fueran a tal acto.</seg>
                <seg xml:id="cab-001-004_s003" type="juridical_discursive_segment">Se dió un <rs
                        xml:id="cab-001-004_cab-001-004_s003_a001" type="legal_or_procedural_act"
                        subtype="grant_of_power">poder</rs> a <persName
                        xml:id="cab-001-004_cab-001-004_s003_a002" type="historicalPerson">Hernan
                    Suárez de Villalobos</persName>,para que apelara en la Audencia los contenidos
                    del <rs xml:id="cab-001-004_cab-001-004_s003_a003" type="normative_source"
                        subtype="auto">auto</rs> que contenian <rs
                        xml:id="cab-001-004_cab-001-004_s003_a004" type="normative_source"
                        subtype="new_laws">nuevas leyes</rs> que afectan a los <term
                        xml:id="cab-001-004_cab-001-004_s003_a005"
                        type="historical_social_legal_category"
                        subtype="colonial_legal_social_category">indios</term> y la tributación del
                    maiz y otras cosas que sacan delas granjas.</seg>
                <seg xml:id="cab-001-004_s004" type="juridical_discursive_segment">Se pidió a los <rs
                        xml:id="cab-001-004_cab-001-004_s004_a001" type="role_or_office"
                        subtype="office_or_procedural_role">diputados</rs> <persName
                        xml:id="cab-001-004_cab-001-004_s004_a002" type="historicalPerson">Juan
                    Rodriguez</persName>, <persName xml:id="cab-001-004_cab-001-004_s004_a003"
                        type="historicalPerson">Diego de Paredes</persName> defender las causas de
                    la ciudad.</seg>
                <seg xml:id="cab-001-004_s005" type="juridical_discursive_segment"><date
                        xml:id="cab-001-004_cab-001-004_s005_a001" type="sourceDate">2 de Septiembre
                    1547</date>, se tratá lo relacionado a lo ausencia del <rs
                        xml:id="cab-001-004_cab-001-004_s005_a002" type="role_or_office"
                        subtype="office_or_procedural_role">teniente</rs>, quien se encuentra fuera
                    de la ciudad, el señor <rs xml:id="cab-001-004_cab-001-004_s005_a003"
                        type="role_or_office" subtype="office_or_procedural_role">gobernador</rs> <rs
                        xml:id="cab-001-004_cab-001-004_s005_a004" type="legal_or_procedural_act"
                        subtype="order_event">mandó</rs> que a su llegada debia justificar la razón
                    de su audencia.</seg>
                <seg xml:id="cab-001-004_s006" type="juridical_discursive_segment">En la reunión se
                    habló de un caballo y una yegua que se dejan a cargo de <persName
                        xml:id="cab-001-004_cab-001-004_s006_a001" type="historicalPerson">Gómez de
                    Cifuentes</persName>.</seg>
                <seg xml:id="cab-001-004_s007" type="juridical_discursive_segment">En este <orgName
                        xml:id="cab-001-004_cab-001-004_s007_a001" type="cabildo">Cabildo</orgName>
                    se <rs xml:id="cab-001-004_cab-001-004_s007_a002" type="legal_or_procedural_act"
                        subtype="presentation">presentó</rs> <persName
                        xml:id="cab-001-004_cab-001-004_s007_a003" type="historicalPerson">Juan de
                    la Peña</persName> con una <rs xml:id="cab-001-004_cab-001-004_s007_a004"
                        type="legal_or_procedural_act" subtype="petition">petición</rs> para que se
                    coloque remedio a la carcel, <date xml:id="cab-001-004_cab-001-004_s007_a005"
                        type="sourceDate">10 de Octubre 1547</date>.</seg>
                <seg xml:id="cab-001-004_s008" type="juridical_discursive_segment">Se <rs
                        xml:id="cab-001-004_cab-001-004_s008_a001" type="legal_or_procedural_act"
                        subtype="presentation">presentó</rs> un <rs
                        xml:id="cab-001-004_cab-001-004_s008_a002" type="normative_source"
                        subtype="mandate">mandamiento</rs> del señor <rs
                        xml:id="cab-001-004_cab-001-004_s008_a003" type="role_or_office"
                        subtype="office_or_procedural_role">Gobernador</rs> para que se hagan los <rs
                        xml:id="cab-001-004_cab-001-004_s008_a004" type="legal_or_procedural_act"
                        subtype="repartimiento">repartimientos</rs> de esta ciudad.</seg>
                <seg xml:id="cab-001-004_s009" type="juridical_discursive_segment">Don <persName
                        xml:id="cab-001-004_cab-001-004_s009_a001" type="historicalPerson">Pedro de
                    Arevalo</persName> <rs xml:id="cab-001-004_cab-001-004_s009_a002"
                        type="legal_or_procedural_act" subtype="presentation">presentó</rs> una <rs
                        xml:id="cab-001-004_cab-001-004_s009_a003" type="legal_or_procedural_act"
                        subtype="petition">petición</rs> en la que se solicita un hierro para las
                    vacas y otros ganados con el fin de herrarlos.</seg>
                <seg xml:id="cab-001-004_s010" type="juridical_discursive_segment">En dicho <orgName
                        xml:id="cab-001-004_cab-001-004_s010_a001" type="cabildo">Cabildo</orgName> <persName
                        xml:id="cab-001-004_cab-001-004_s010_a002" type="historicalPerson">Martin de
                    San Juan</persName> <rs xml:id="cab-001-004_cab-001-004_s010_a003"
                        type="role_or_office" subtype="office_or_procedural_role">Alquacil</rs> <rs
                        xml:id="cab-001-004_cab-001-004_s010_a004" type="legal_or_procedural_act"
                        subtype="presentation">presentó</rs> una <rs
                        xml:id="cab-001-004_cab-001-004_s010_a005" type="legal_or_procedural_act"
                        subtype="petition">petición</rs> para que se le descargue del oficio de <rs
                        xml:id="cab-001-004_cab-001-004_s010_a006" type="role_or_office"
                        subtype="office_or_procedural_role">carcelero</rs> negándoce la <rs
                        xml:id="cab-001-004_cab-001-004_s010_a007" type="legal_or_procedural_act"
                        subtype="petition">petición</rs> por los señores <orgName
                        xml:id="cab-001-004_cab-001-004_s010_a008" type="cabildo_body">Justicia y
                    Regimiento</orgName>.</seg>
                <seg xml:id="cab-001-004_s011" type="juridical_discursive_segment">Los señores <orgName
                        xml:id="cab-001-004_cab-001-004_s011_a001" type="cabildo_body">Justicia y
                    Regimiento</orgName> <rs xml:id="cab-001-004_cab-001-004_s011_a002"
                        type="legal_or_procedural_act" subtype="decision">acordaron</rs> <rs
                        xml:id="cab-001-004_cab-001-004_s011_a003" type="legal_or_procedural_act"
                        subtype="appointment">nombrar</rs> por <rs
                        xml:id="cab-001-004_cab-001-004_s011_a004" type="role_or_office"
                        subtype="office_or_procedural_role">escribano público</rs> y de <orgName
                        xml:id="cab-001-004_cab-001-004_s011_a005" type="cabildo">Cabildo</orgName>
                    a Don <persName xml:id="cab-001-004_cab-001-004_s011_a006"
                        type="historicalPerson">Juan de Padilla</persName>, mientras dure el señor <persName
                        xml:id="cab-001-004_cab-001-004_s011_a007" type="historicalPerson">Juan de
                    Chinchillas</persName> fuera de la ciudad se firmo un documento en el que el
                    señor Padilla recibe el <rs xml:id="cab-001-004_cab-001-004_s011_a008"
                        type="role_or_office" subtype="office_or_procedural_role">escribano</rs>
                    Chinchilla el cargo de <rs xml:id="cab-001-004_cab-001-004_s011_a009"
                        type="role_or_office" subtype="office_or_procedural_role">Escribano</rs>
                    comprometiendose a cumplir con sus obligaciones en el <orgName
                        xml:id="cab-001-004_cab-001-004_s011_a010" type="cabildo">Cabildo</orgName>.</seg>
            </div>
        </body>

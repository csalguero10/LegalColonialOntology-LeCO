    <text>
        <body>
            <div type="acta" xml:id="cab-001-055_acta">
                <seg xml:id="cab-001-055_s001" type="juridical_discursive_segment"><placeName
                        xml:id="cab-001-055_cab-001-055_s001_a001" type="historicalPlace">Tunja</placeName>
                    , <date xml:id="cab-001-055_cab-001-055_s001_a002" type="sourceDate">7 de
                    Noviembre 1550</date>.</seg>
                <seg xml:id="cab-001-055_s002" type="juridical_discursive_segment">Se llevó a cabo
                    otra reunión del <orgName xml:id="cab-001-055_cab-001-055_s002_a001"
                        type="cabildo">Cabildo</orgName>, en la que se <rs
                        xml:id="cab-001-055_cab-001-055_s002_a002" type="legal_or_procedural_act"
                        subtype="presentation">presentó</rs> ua <rs
                        xml:id="cab-001-055_cab-001-055_s002_a003" type="legal_or_procedural_act"
                        subtype="petition">petición</rs> de <persName
                        xml:id="cab-001-055_cab-001-055_s002_a004" type="historicalPerson">Martin
                    Sanchez Ropero</persName>, quien pide un sitio para construir un molino cerca al
                    puente del camino, real.</seg>
                <seg xml:id="cab-001-055_s003" type="juridical_discursive_segment">Tambien
                    sepresentó otra <rs xml:id="cab-001-055_cab-001-055_s003_a001"
                        type="legal_or_procedural_act" subtype="petition">petición</rs> por parte de <persName
                        xml:id="cab-001-055_cab-001-055_s003_a002" type="historicalPerson">Hernando
                    Rojas</persName>, quien solicita unas tierras para ganados mayor en términos de <placeName
                        xml:id="cab-001-055_cab-001-055_s003_a003" type="historicalPlace">Tunja</placeName>
                    .</seg>
                <seg xml:id="cab-001-055_s004" type="juridical_discursive_segment">Los señores <orgName
                        xml:id="cab-001-055_cab-001-055_s004_a001" type="cabildo_body">Justicia y
                    Regimiento</orgName> <rs xml:id="cab-001-055_cab-001-055_s004_a002"
                        type="legal_or_procedural_act" subtype="approval">aprobaron</rs> los titulos
                    de tierra solicitados, siempre y cuando no existan problemas con los <term
                        xml:id="cab-001-055_cab-001-055_s004_a003"
                        type="historical_social_legal_category"
                        subtype="colonial_legal_social_category">naturales</term> ó terceros.</seg>
                <seg xml:id="cab-001-055_s005" type="juridical_discursive_segment">Se <rs
                        xml:id="cab-001-055_cab-001-055_s005_a001" type="legal_or_procedural_act"
                        subtype="order_event">ordenó</rs> dar al <rs
                        xml:id="cab-001-055_cab-001-055_s005_a002" type="legal_or_procedural_act"
                        subtype="proclamation">pregón</rs> en la plaza principal.</seg>
                <seg xml:id="cab-001-055_s006" type="juridical_discursive_segment">En este <orgName
                        xml:id="cab-001-055_cab-001-055_s006_a001" type="cabildo">Cabildo</orgName>,
                    se <rs xml:id="cab-001-055_cab-001-055_s006_a002" type="legal_or_procedural_act"
                        subtype="approval">aprobó</rs> <rs xml:id="cab-001-055_cab-001-055_s006_a003"
                        type="legal_or_procedural_act" subtype="collection">cobrar</rs> $40 pesos
                    del buen oro en cada un año por los propios de la ciudad, en constancia firmaron
                    los capituladores.</seg>
            </div>
        </body>

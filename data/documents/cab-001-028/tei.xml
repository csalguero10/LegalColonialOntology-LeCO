    <text>
        <body>
            <div type="acta" xml:id="cab-001-028_acta">
                <seg xml:id="cab-001-028_s001" type="juridical_discursive_segment"><placeName
                        xml:id="cab-001-028_cab-001-028_s001_a001" type="historicalPlace">Tunja</placeName>
                    , <date xml:id="cab-001-028_cab-001-028_s001_a002" type="sourceDate">21 junio
                    1548</date>.</seg>
                <seg xml:id="cab-001-028_s002" type="juridical_discursive_segment">Los señores <orgName
                        xml:id="cab-001-028_cab-001-028_s002_a001" type="cabildo_body">Justicia y
                    Regimiento</orgName> trataron lo relacionado con un acuerdo y parecer respondio
                    por el señor <rs xml:id="cab-001-028_cab-001-028_s002_a002"
                        type="role_or_office" subtype="office_or_procedural_role">Gobernador</rs>
                    quien manifesto no ser obedecido para que se diera las fianzas y se obligaron
                    ser cumplidas por parte del <orgName xml:id="cab-001-028_cab-001-028_s002_a003"
                        type="cabildo">Cabildo</orgName>.</seg>
                <seg xml:id="cab-001-028_s003" type="juridical_discursive_segment">En la ciudad de <placeName
                        xml:id="cab-001-028_cab-001-028_s003_a001" type="historicalPlace">Tunja</placeName>
                    a 11 días del mes de Julio de 1548, se reunieron los miembros del <orgName
                        xml:id="cab-001-028_cab-001-028_s003_a002" type="cabildo">Cabildo</orgName>,
                    para tratar los asuntos del <term xml:id="cab-001-028_cab-001-028_s003_a003"
                        type="historical_concept" subtype="real_service">Real Servicio</term>.</seg>
                <seg xml:id="cab-001-028_s004" type="juridical_discursive_segment">Los señores <orgName
                        xml:id="cab-001-028_cab-001-028_s004_a001" type="cabildo_body">Justicia y
                    Regimiento</orgName> pidieron al señor <rs
                        xml:id="cab-001-028_cab-001-028_s004_a002" type="role_or_office"
                        subtype="office_or_procedural_role">Gobernador</rs> los quintos reales para
                    la ciudad de <placeName xml:id="cab-001-028_cab-001-028_s004_a003"
                        type="historicalPlace">Tunja</placeName> y <placeName
                        xml:id="cab-001-028_cab-001-028_s004_a004" type="historicalPlace">Velez</placeName>,
                    lo mismo que se nombra aun encargado para ello, incluyendo los cuatos de oro y
                    bronce, para el <term xml:id="cab-001-028_cab-001-028_s004_a005"
                        type="historical_concept" subtype="common_good">bien de esta República</term>
                    .</seg>
            </div>
        </body>

    <text>
        <body>
            <div type="acta" xml:id="cab-001-046_acta">
                <seg xml:id="cab-001-046_s001" type="juridical_discursive_segment">En el <orgName
                        xml:id="cab-001-046_cab-001-046_s001_a001" type="cabildo">Cabildo</orgName>
                    del <date xml:id="cab-001-046_cab-001-046_s001_a002" type="sourceDate">7 de
                    Marzo de 1550</date> se trató lo relacionado al pago de aranceles por parte de
                    los carpinteros, el <rs xml:id="cab-001-046_cab-001-046_s001_a003"
                        type="role_or_office" subtype="office_or_procedural_role">Gobernador</rs> <persName
                        xml:id="cab-001-046_cab-001-046_s001_a004" type="historicalPerson">Miguel
                    Diaz de Armendaris</persName> <rs xml:id="cab-001-046_cab-001-046_s001_a005"
                        type="legal_or_procedural_act" subtype="order_event">ordenó</rs> se cobrara
                    dichos aranceles de acuerdo a lo establecido.</seg>
                <seg xml:id="cab-001-046_s002" type="juridical_discursive_segment"><date
                        xml:id="cab-001-046_cab-001-046_s002_a001" type="sourceDate">8 de marzo 1550</date>,
                    se <rs xml:id="cab-001-046_cab-001-046_s002_a002" type="legal_or_procedural_act"
                        subtype="order_event">ordenó</rs> dar al <rs
                        xml:id="cab-001-046_cab-001-046_s002_a003" type="legal_or_procedural_act"
                        subtype="proclamation">pregón</rs> el valor de los aranceles que debian
                    pagar los carpinteros.</seg>
                <seg xml:id="cab-001-046_s003" type="juridical_discursive_segment"><date
                        xml:id="cab-001-046_cab-001-046_s003_a001" type="sourceDate">21 de marzo
                    1550</date>.</seg>
                <seg xml:id="cab-001-046_s004" type="juridical_discursive_segment">En este <orgName
                        xml:id="cab-001-046_cab-001-046_s004_a001" type="cabildo">Cabildo</orgName> <persName
                        xml:id="cab-001-046_cab-001-046_s004_a002" type="historicalPerson">Alonso
                    Tellez</persName> y <persName xml:id="cab-001-046_cab-001-046_s004_a003"
                        type="historicalPerson">Pedro de Colmenares</persName> informaron de los
                    negocios de la ciudad: Relación de lo que el señor ha negociado en la tocante a
                    este reino.</seg>
                <seg xml:id="cab-001-046_s005" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s005_a001" type="normative_source"
                        subtype="provision">provisión</rs> para que la tierra se reparta de nuevo en
                    ciertas condiciones.</seg>
                <seg xml:id="cab-001-046_s006" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s006_a001" type="normative_source"
                        subtype="provision">provisión</rs> en la mitad de los cuentos de cámara.</seg>
                <seg xml:id="cab-001-046_s007" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s007_a001" type="normative_source"
                        subtype="royal_cedula">cédula</rs> para que se de propios a las ciudades.</seg>
                <seg xml:id="cab-001-046_s008" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s008_a001" type="normative_source"
                        subtype="provision">provisión</rs> sobre la que había traído el <rs
                        xml:id="cab-001-046_cab-001-046_s008_a002" type="role_or_office"
                        subtype="office_or_procedural_role">obispo</rs> para que los <term
                        xml:id="cab-001-046_cab-001-046_s008_a003"
                        type="historical_social_legal_category" subtype="religious_legal_category">
                    judios</term> se pusieran en cabeza del Rey se retire la <rs
                        xml:id="cab-001-046_cab-001-046_s008_a004" type="normative_source"
                        subtype="order">orden</rs>.</seg>
                <seg xml:id="cab-001-046_s009" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s009_a001" type="normative_source"
                        subtype="royal_cedula">cédula</rs> para que haya buen recado en la
                    fundición.</seg>
                <seg xml:id="cab-001-046_s010" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s010_a001" type="normative_source"
                        subtype="royal_cedula">cédula</rs> para que el <rs
                        xml:id="cab-001-046_cab-001-046_s010_a002" type="role_or_office"
                        subtype="office_or_procedural_role">obispo</rs> de <placeName
                        xml:id="cab-001-046_cab-001-046_s010_a003" type="historicalPlace">Santa
                    Marta</placeName> viaje al reino.</seg>
                <seg xml:id="cab-001-046_s011" type="juridical_discursive_segment">Una <rs
                        xml:id="cab-001-046_cab-001-046_s011_a001" type="normative_source"
                        subtype="royal_cedula">cédula</rs> para traer a los <term
                        xml:id="cab-001-046_cab-001-046_s011_a002"
                        type="historical_social_legal_category" subtype="religious_legal_category">
                    judios</term> de esta Gobernación de la de <placeName
                        xml:id="cab-001-046_cab-001-046_s011_a003" type="historicalPlace">Popayán</placeName>,
                    Una <rs xml:id="cab-001-046_cab-001-046_s011_a004" type="normative_source"
                        subtype="royal_cedula">cédula</rs> para que traigan los <term
                        xml:id="cab-001-046_cab-001-046_s011_a005"
                        type="historical_social_legal_category"
                        subtype="colonial_legal_social_category">indios</term> de esta Gobernación,
                    que se encuentren en <placeName xml:id="cab-001-046_cab-001-046_s011_a006"
                        type="historicalPlace">Cartagena</placeName>.</seg>
                <seg xml:id="cab-001-046_s012" type="juridical_discursive_segment">Un <rs
                        xml:id="cab-001-046_cab-001-046_s012_a001" type="normative_source"
                        subtype="title">titulo</rs> de ciudad a <placeName
                        xml:id="cab-001-046_cab-001-046_s012_a002" type="historicalPlace">Tocayma</placeName>
                    y $400 "gms" ducados para la iglesia y 1000 ducados parala de <placeName
                        xml:id="cab-001-046_cab-001-046_s012_a003" type="historicalPlace">Santa fé</placeName>
                    .</seg>
                <seg xml:id="cab-001-046_s013" type="juridical_discursive_segment">Los señores <orgName
                        xml:id="cab-001-046_cab-001-046_s013_a001" type="cabildo_body">Justicia y
                    Regimiento</orgName> dijeron se provea lo que mas conviene a la ciudad y la <term
                        xml:id="cab-001-046_cab-001-046_s013_a002" type="historical_concept"
                        subtype="republic">República</term>.</seg>
            </div>
        </body>

@prefix ex: <https://w3id.org/leco/data/example/> .
@prefix leco: <https://w3id.org/leco/ontology#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Documento y segmentos
ex:doc_d002
    a leco:LegalDocument , prov:Entity ;
    leco:hasDocumentType leco:ActaCabildoDocumentType .

ex:segment_s3
    a leco:LegalDocumentPart , prov:Entity ;
    rico:isDirectConstituentOf ex:doc_d002 ;
    leco:documentsAct ex:sanction_1547 .

ex:segment_s4
    a leco:LegalDocumentPart , prov:Entity ;
    rico:isDirectConstituentOf ex:doc_d002 ;
    leco:documentsAct ex:appeal_1547 .

# Actores e instituciones
ex:JuanDePineda
    a rico:Person , rico:Agent .

ex:CabildoDeTunja
    a rico:CorporateBody , rico:Group , rico:Agent ;
    leco:hasInstitutionType leco:CabildoType ;
    leco:exercisesJurisdiction ex:JurisdiccionCabildoTunja .

ex:RealAudiencia
    a rico:CorporateBody , rico:Group , rico:Agent ;
    leco:hasInstitutionType leco:AudienciaType ;
    leco:exercisesJurisdiction ex:JurisdiccionAudiencia .

ex:Tunja a rico:Place .

# Jurisdicciones
ex:JurisdiccionCabildoTunja
    a leco:Jurisdiction ;
    leco:jurisdictionExercisedBy ex:CabildoDeTunja ;
    leco:territorialScope ex:Tunja .

ex:JurisdiccionAudiencia
    a leco:Jurisdiction ;
    leco:jurisdictionExercisedBy ex:RealAudiencia ;
    leco:territorialScope ex:Tunja .

# Sanción
ex:sanction_1547
    a leco:Sanction , leco:LegalDecision , leco:JurisdictionalAct ;
    leco:withinJurisdiction ex:JurisdiccionCabildoTunja ;
    leco:decidedBy ex:CabildoDeTunja ;
    leco:sanctions ex:JuanDePineda ;
    leco:hasParticipant ex:JuanDePineda .

# Apelación y participación contextualizada
ex:appeal_1547
    a leco:Appeal , leco:ProceduralAct , leco:JurisdictionalAct ;
    leco:withinJurisdiction ex:JurisdiccionAudiencia ;
    leco:appealsAgainst ex:sanction_1547 ;
    leco:beforeAuthority ex:RealAudiencia ;
    leco:hasParticipation ex:participation_pineda_appellant .

ex:participation_pineda_appellant
    a leco:Participation ;
    leco:participationActor ex:JuanDePineda ;
    leco:participationRole leco:AppellantRole ;
    leco:participationInAct ex:appeal_1547 .

# Oficio y ocupación temporalizada
ex:AlcaldeOrdinarioTunja
    a leco:Office ;
    leco:hasOfficeType leco:OrdinaryMayorOfficeType ;
    leco:officeExistsIn ex:CabildoDeTunja .

ex:date1547 a rico:Date .

ex:PinedaOfficeHolding1547
    a rico:PositionHoldingRelation ;
    rico:relationHasSource ex:JuanDePineda ;
    rico:relationHasTarget ex:AlcaldeOrdinarioTunja ;
    rico:relationHasDate ex:date1547 .

# Anotación semántica: "apelante" es inferido del acto de apelar
ex:annotation_appellant
    a leco:SemanticAnnotation ;
    leco:annotationTarget ex:segment_s4 ;
    leco:annotationBody leco:AppellantRole ;
    leco:annotationBasis leco:InferredFromText ;
    leco:hasValidationStatus leco:HumanValidatedAnnotation ;
    leco:confidenceScore "0.90"^^xsd:decimal ;
    leco:attestedIn ex:segment_s4 ;
    prov:wasGeneratedBy ex:annotation_activity_1 .

ex:annotation_activity_1 a leco:AnnotationActivity .

#################################################################
# Ampliación del fixture: C07, C08 y C12
# Basada únicamente en expresiones presentes en la transcripción piloto:
# - "Real Servicio"
# - "incumplimiento con el deber de Alcalde Ordinario"
# - "Se ordenó investigar las acciones y comportamiento del señor Pineda"
#################################################################

# Segmentos adicionales de evidencia
ex:segment_s1
    a leco:LegalDocumentPart , prov:Entity ;
    rico:isDirectConstituentOf ex:doc_d002 .

ex:segment_s6
    a leco:LegalDocumentPart , prov:Entity ;
    rico:isDirectConstituentOf ex:doc_d002 ;
    leco:documentsAct ex:investigation_order_1547 , ex:investigation_1547 .

# Uso contextualizado del concepto histórico "Real Servicio" (C08)
ex:real_service_use_1547
    a leco:HistoricalConceptUse ;
    leco:conceptUsed leco:RealServiceConcept ;
    leco:attestedIn ex:segment_s1 ;
    leco:lexicalForm "Real Servicio" ;
    leco:conceptUseJurisdiction ex:JurisdiccionCabildoTunja ;
    leco:conceptUseTime ex:date1547 .

# Regla/deber normativo expresado en el propio texto (C07/C12)
ex:duty_alcalde_ordinario
    a leco:LegalDuty , leco:NormativeRule ;
    leco:lexicalForm "deber de Alcalde Ordinario" .

# Argumento jurídico: el eventual fallo se vincula al incumplimiento del deber
ex:argument_incumplimiento_deber
    a leco:LegalArgument ;
    leco:argumentInvokesRule ex:duty_alcalde_ordinario .

# Orden de investigar y actuación investigativa
ex:investigation_order_1547
    a leco:OrderAct , leco:LegalDecision , leco:JurisdictionalAct ;
    leco:withinJurisdiction ex:JurisdiccionAudiencia ;
    leco:decidedBy ex:RealAudiencia ;
    leco:hasParticipant ex:JuanDePineda ;
    leco:hasLegalArgument ex:argument_incumplimiento_deber ;
    leco:ordersAct ex:investigation_1547 .

ex:investigation_1547
    a leco:Investigation , leco:ProceduralAct , leco:JurisdictionalAct ;
    leco:withinJurisdiction ex:JurisdiccionAudiencia ;
    leco:investigates ex:JuanDePineda ;
    leco:hasParticipant ex:JuanDePineda .

# Provenance note: attribution of the investigation order to the Real Audiencia
# is an interpretation of the narrative sequence and is therefore explicit as
# a semantic annotation rather than silently treated as literal transcription.
ex:annotation_investigation_authority
    a leco:SemanticAnnotation ;
    leco:annotationTarget ex:segment_s6 ;
    leco:annotationBody ex:RealAudiencia ;
    leco:annotationBasis leco:InferredFromText ;
    leco:hasValidationStatus leco:HumanValidatedAnnotation ;
    leco:confidenceScore "0.80"^^xsd:decimal ;
    leco:attestedIn ex:segment_s6 ;
    prov:wasGeneratedBy ex:annotation_activity_2 .

ex:annotation_activity_2 a leco:AnnotationActivity .
